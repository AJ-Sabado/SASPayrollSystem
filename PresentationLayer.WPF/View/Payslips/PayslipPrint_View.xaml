<Window x:Class="PresentationLayer.WPF.View.Payslips.PayslipPrint_View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PresentationLayer.WPF.View.Payslips"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
        xmlns:psTemp="clr-namespace:PresentationLayer.WPF.View.Payslips"
    
        Title="Employee Payslip"
        WindowStartupLocation="CenterScreen"
        Width="750" Height="900" 
        Background="White">

    <Grid Margin="0.5in">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Print Employee Payslip" 
                   FontFamily="{StaticResource PoppinsBold}" 
                   FontSize="24" 
                   HorizontalAlignment="Left" 
                   Margin="0,10,160,10"/>
            <Button x:Name="btnPreviewPayslip" Content="Cancel"
                 FontFamily="{StaticResource PoppinsBold}" FontSize="12"
                 Width="90" Height="35"
                 materialDesign:ButtonAssist.CornerRadius="17.5"
                 Style="{StaticResource MaterialDesignOutlinedButton}"
                 Margin="0,0,10,0"
                 BorderBrush="DarkRed"
                 Foreground="DarkRed"
                 Background="LightPink"
                 Click="btnPreviewPayslip_Click"/>
            <Button x:Name="btnPrintPayslip" Content="Print"
                FontFamily="{StaticResource PoppinsBold}" FontSize="12"
                Width="90" Height="35"
                materialDesign:ButtonAssist.CornerRadius="17.5"
                Style="{StaticResource MaterialDesignRaisedButton}"
                Margin="5,0,0,0"
                Foreground="DarkGreen"
                Background="LightGreen"
                BorderBrush="DarkGreen"
                Command="{Binding PrintPayslipCommand}"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1" Margin="0,10">
            <psTemp:PayslipRegTemplate/>
        </Border>
    </Grid>
</Window>
