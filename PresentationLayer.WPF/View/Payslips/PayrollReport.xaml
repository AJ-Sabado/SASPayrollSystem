<UserControl  x:Class="PresentationLayer.WPF.View.Payslips.PayrollReport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PresentationLayer.WPF.View.Payslips"
             mc:Ignorable="d">
    <Viewbox>
        <Grid Width="11in" MinHeight="14.24in" Height="Auto" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"  BorderBrush="Black" BorderThickness="2" Padding="2" Margin="0.5in,0.5in,0.5in,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="117"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="58"/>

                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="Black" BorderThickness="2">
                        <Grid Height="80">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="6*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Logo -->
                            <Image 
                                   Source="C:\Users\Timro\OneDrive\Documents\PROGRAMMING PROJECTS\STRATEGIC ASSISTANT PAYROLL\DESIGN\PresentationLayer.WPF\Resources\Images\SAS_LOGO_CLEARBG.png"
                                   Stretch="Uniform" Margin="76,0,430,0" Grid.ColumnSpan="3"/>

                            <!-- Company Info -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,5">
                                <TextBlock Text="STRATEGIC ASSISTANT SOLUTIONS INC" 
                                           FontWeight="Bold" FontFamily="{StaticResource PoppinsBlack}"
                                           FontSize="20" HorizontalAlignment="Center"
                                            Foreground="#B8860B"/>
                                <TextBlock Text="Unit 18-21 Jomafer Building,Dolores City of San Fernando, Pampanga" 
                                            FontSize="12" FontFamily="{StaticResource PoppinsMedium}"
                                           HorizontalAlignment="Center" Margin="0,2"/>
                                <TextBlock Text="admin@strategic-assistant.com" 
                                            FontSize="12" FontFamily="{StaticResource PoppinsMedium}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" BorderBrush="Black" BorderThickness="2" Margin="1,2,0,0" >
                        <StackPanel>
                            <TextBlock Text="P  A  Y  R  O  L  L" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="18"
                                        HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <!--DURATION AND PAYSIP LABEL-->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="Black" BorderThickness="2" Margin="0,2,1,0">
                            <StackPanel Margin="3" HorizontalAlignment="Center" Orientation="Horizontal" >
                                <TextBlock Text="COVERED PERIOD:     " FontFamily="{StaticResource PoppinsSemiBold}" FontSize="13" />
                                <TextBlock Text="01/01/2001 to 02/02/2002" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" BorderBrush="Black" BorderThickness="2" Margin="1,2,0,0">
                            <StackPanel Margin="3" HorizontalAlignment="Center" Orientation="Horizontal" >
                                <TextBlock Text="REGULAR EMPLOYEE PAYROLL" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="13" />
                            </StackPanel>
                        </Border>



                    </Grid>

                    <Grid Grid.Row="3">
                        <Border BorderBrush="Black" BorderThickness="2" Margin="0,2,0,0">
                            <DataGrid AutoGenerateColumns="False" 
                                      CanUserAddRows="False" 
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      Margin="10"
                                      MinHeight="290"
                                      Height="850"
                                      Width="928"
                                      Background="White"
                                      RowBackground="White"
                                      AlternatingRowBackground="White"
                                      FontSize="8">
                                <DataGrid.Resources>
                                    <!-- Header style with wrapping -->
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="8"/>
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Height" Value="40"/>
                                        <Setter Property="BorderBrush" Value="Black"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" 
                                           TextWrapping="Wrap" 
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="2"/>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>

                                    <!-- Row style -->
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Setter Property="FontSize" Value="8"/>
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Height" Value="30"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                </DataGrid.Resources>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Employee ID" Binding="{Binding EmployeeID}" Width="58"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="130"/>
                                    <DataGridTextColumn Header="Basic Pay" Binding="{Binding BasicPay}" Width="61"/>
                                    <DataGridTextColumn Header="Holiday Pay" Binding="{Binding HolidayPay}" Width="61"/>
                                    <DataGridTextColumn Header="Overtime Pay" Binding="{Binding OvertimePay}" Width="61"/>
                                    <DataGridTextColumn Header="Paid Leaves" Binding="{Binding PaidLeaves}" Width="61"/>
                                    <DataGridTextColumn Header="Bonus" Binding="{Binding Bonus}" Width="61"/>
                                    <DataGridTextColumn Header="Allowance" Binding="{Binding Allowance}" Width="61"/>
                                    <DataGridTextColumn Header="Gross Pay" Binding="{Binding GrossPay}" Width="61"/>
                                    <DataGridTextColumn Header="Withholding Tax" Binding="{Binding WithholdingTax}" Width="61"/>
                                    <DataGridTextColumn Header="Government Contributions" Binding="{Binding GovernmentContributions}" Width="61"/>
                                    <DataGridTextColumn Header="Loan Deductions" Binding="{Binding LoanDeductions}" Width="61"/>
                                    <DataGridTextColumn Header="Late/Undertime Deductions" Binding="{Binding LateUndertimeDeductions}" Width="61"/>
                                    <DataGridTextColumn Header="Net Salary" Binding="{Binding NetSalary}" Width="83"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>





                    <!--TOTAL LABELS-->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!--TOTAL GROSS PAY-->
                        <Border Grid.Column="0" BorderBrush="Black" BorderThickness="2" Margin="0,2,1,2">
                            <TextBlock Grid.Row="2" Grid.Column="0"  Margin="2"
                                    Text="TOTAL GROSS PAY" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                    FontFamily="{StaticResource PoppinsSemiBold}" FontSize="15" />
                        </Border>

                        <Border Grid.Column="1" BorderBrush="Black" BorderThickness="2" Margin="1,2,1,2">
                            <TextBlock Grid.Row="2" Grid.Column="0"  Margin="2"
                                   Text="29,568.00" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{StaticResource PoppinsBold}" FontSize="15" />
                        </Border>

                        <!--TOTAL NET PAY-->
                        <Border Grid.Column="2" BorderBrush="Black" BorderThickness="2" Margin="1,2,1,2">
                            <TextBlock Grid.Row="2" Grid.Column="0"  Margin="2"
                                   Text="TOTAL NET PAY" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{StaticResource PoppinsSemiBold}" FontSize="15" />
                        </Border>

                        <Border Grid.Column="3" BorderBrush="Black" BorderThickness="2" Margin="1,2,0,2">
                            <TextBlock Grid.Row="2" Grid.Column="0"  Margin="2"
                                   Text="28,321.25" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{StaticResource PoppinsBold}" FontSize="15"
                                   Foreground="DarkGreen"/>
                        </Border>
                    </Grid>

                </Grid>
            </Border>

            <!--FOOTER-->
            <Grid Grid.Row="1" Margin="0.5in,2,0.5in,0.5in">
                <Grid.RowDefinitions>
                    <RowDefinition Height="43"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!--remarks-->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="REMARKS:" Margin="0,0,10,0"
                           FontSize="15" FontFamily="{StaticResource PoppinsBold}"/>
                    <TextBlock Text="N/A" TextWrapping="Wrap"
                           FontSize="15"  MaxWidth="640"/>
                </StackPanel>

                <!--SIGNATORIES-->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="25"/>
                    </Grid.RowDefinitions>

                    <!--PREPARED BY:-->
                    <TextBlock Text="PREPARED BY:"
                           VerticalAlignment="Bottom"
                           FontSize="12" FontFamily="{StaticResource PoppinsMedium}"/>
                    <Border Grid.Row="1" Grid.Column="0"
                        BorderBrush="Black" BorderThickness="0,0,0,1.5">
                        <TextBlock Text="ADMIN NAME"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom"
                               FontSize="14" FontFamily="{StaticResource PoppinsRegular}"/>
                    </Border>

                    <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="ADMIN POSITION"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom"
                           FontSize="14" FontFamily="{StaticResource PoppinsBold}"/>

                    <!-- RECEIVED BY: -->
                    <TextBlock Grid.Column="2"
                           Text="RECEIVED BY:"
                           VerticalAlignment="Bottom"
                           FontSize="12" FontFamily="{StaticResource PoppinsMedium}"/>

                    <Border Grid.Row="1" Grid.Column="2"
                        BorderBrush="Black" BorderThickness="0,0,0,1.5">
                        <TextBlock Text="EMPLOYEE NAME"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom"
                               FontSize="14" FontFamily="{StaticResource PoppinsRegular}"/>
                    </Border>

                    <TextBlock Grid.Row="2" Grid.Column="2"
                           Text="EMPLOYEE POSITION"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom"
                           FontSize="14" FontFamily="{StaticResource PoppinsBold}"/>
                </Grid>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>