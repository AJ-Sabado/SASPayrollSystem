<Window x:Class="PresentationLayer.WPF.View.Payslips.PayslipPreview_View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PresentationLayer.WPF.View.Payslips"
        mc:Ignorable="d"
        
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
        xmlns:psTemp="clr-namespace:PresentationLayer.WPF.View.Payslips"
        
        Title="Employee Payslip"
        Icon="/Resources/Images/SASLogo.png"
        WindowStartupLocation="CenterScreen"
        Width="750" Height="900" 
        Background="White">

    <Grid Margin="0.5in">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Employee Payslip" 
                       FontFamily="{StaticResource PoppinsBold}" 
                       FontSize="24" 
                       HorizontalAlignment="Left" 
                       Margin="0,10,180,10"/>
            <Button x:Name="btnPreviewPayslip" Content="Save PDF"
                     FontFamily="{StaticResource PoppinsBold}" FontSize="12"
                     Width="110" Height="35"
                     materialDesign:ButtonAssist.CornerRadius="17.5"
                     Style="{StaticResource MaterialDesignOutlinedButton}"
                     Margin="0,0,10,0"
                     BorderBrush="DarkGoldenrod"
                     Foreground="DarkGoldenrod"
                     Command="{Binding PreviewPayslipCommand}"/>
            <Button x:Name="btnPrintPayslip" Content="Close"
                    FontFamily="{StaticResource PoppinsBold}" FontSize="12"
                    Width="110" Height="35"
                    materialDesign:ButtonAssist.CornerRadius="17.5"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="5,0,0,0"
                    Foreground="DarkGoldenrod"
                    Background="LightGoldenrodYellow"
                    BorderBrush="DarkGoldenrod"
                    Command="{Binding PrintPayslipCommand}" Click="btnPrintPayslip_Click"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1" Margin="0,10">
            <psTemp:PayslipRegTemplate x:Name="payslipControl"/>
        </Border>
    </Grid>
</Window>
