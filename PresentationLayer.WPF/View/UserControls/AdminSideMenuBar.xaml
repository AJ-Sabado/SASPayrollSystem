<UserControl x:Class="PresentationLayer.WPF.View.UserControls.AdminSideMenuBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PresentationLayer.WPF.View.UserControls"
             
             xmlns:userControls="clr-namespace:PresentationLayer.WPF.View.UserControls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:PresentationLayer.WPF.Helpers"

             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="200">
    
    <UserControl.Resources>
        <helpers:MenuSelectionConverter x:Key="MenuSelectionConverter"/>
    </UserControl.Resources>

    <Border CornerRadius="0" Background="Black" Padding="0,30,0,0">
        <Viewbox Stretch="Uniform">
            <Grid Width="200" Height="688">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20*"/>
                    <RowDefinition Height="80*"/>
                </Grid.RowDefinitions>

                <Image Source="/Resources/Images/SAS_LOGO_BLACKBG.jpg"/>
                <Grid Grid.Row="1" Margin="10,0">

                    <StackPanel>
                        <ToggleButton FontSize="12" HorizontalAlignment="Stretch" Margin="0,2" Style="{StaticResource MenuButtons}"
                                      Command="{Binding DashboardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      IsChecked="{Binding SelectedMenu, RelativeSource={RelativeSource AncestorType=UserControl}, 
                                                  Converter={StaticResource MenuSelectionConverter}, ConverterParameter=Dashboard}">
                                                <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboard" Width="20" Height="20" />
                                <TextBlock Text="Dashboard" VerticalAlignment="Center" Margin="15,0,0,0" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton FontSize="12" HorizontalAlignment="Stretch" Margin="0,2" Style="{StaticResource MenuButtons}"
                                      Command="{Binding PayrollCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      IsChecked="{Binding SelectedMenu, RelativeSource={RelativeSource AncestorType=UserControl}, 
                                                  Converter={StaticResource MenuSelectionConverter}, ConverterParameter=Payroll}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Payment" Width="20" Height="20" />
                                <TextBlock Text="Payroll" VerticalAlignment="Center" Margin="15,0,0,0" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton FontSize="12" HorizontalAlignment="Stretch" Margin="0,2" Style="{StaticResource MenuButtons}"
                                      Command="{Binding EmployeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      IsChecked="{Binding SelectedMenu, RelativeSource={RelativeSource AncestorType=UserControl}, 
                                                  Converter={StaticResource MenuSelectionConverter}, ConverterParameter=Employee}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="WorkerOutline" Width="20" Height="20" />
                                <TextBlock Text="Employee" VerticalAlignment="Center" Margin="15,0,0,0" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton FontSize="12" HorizontalAlignment="Stretch" Margin="0,2" Style="{StaticResource MenuButtons}"
                                      Command="{Binding WorkLogsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      IsChecked="{Binding SelectedMenu, RelativeSource={RelativeSource AncestorType=UserControl}, 
                                                  Converter={StaticResource MenuSelectionConverter}, ConverterParameter=WorkLogs}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Work" Width="20" Height="20" />
                                <TextBlock Text="Work Logs" VerticalAlignment="Center" Margin="15,0,0,0" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton FontSize="12" HorizontalAlignment="Stretch" Margin="0,2" Style="{StaticResource MenuButtons}"
                                      Command="{Binding AdministrationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      IsChecked="{Binding SelectedMenu, RelativeSource={RelativeSource AncestorType=UserControl}, 
                                                  Converter={StaticResource MenuSelectionConverter}, ConverterParameter=Administration}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AdministratorOutline" Width="20" Height="20" />
                                <TextBlock Text="Administration" VerticalAlignment="Center" Margin="15,0,0,0" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton FontSize="12" HorizontalAlignment="Stretch" Margin="0,2" Style="{StaticResource MenuButtons}"
                                      Command="{Binding AccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      IsChecked="{Binding SelectedMenu, RelativeSource={RelativeSource AncestorType=UserControl}, 
                                                  Converter={StaticResource MenuSelectionConverter}, ConverterParameter=Account}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Account" Width="20" Height="20" />
                                <TextBlock Text="Account" VerticalAlignment="Center" Margin="15,0,0,0" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                </Grid>
            </Grid>
        </Viewbox>
    </Border>
</UserControl>
