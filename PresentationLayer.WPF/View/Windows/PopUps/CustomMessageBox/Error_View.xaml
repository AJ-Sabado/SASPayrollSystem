<Window x:Class="PresentationLayer.WPF.View.Windows.PopUps.CustomMessageBox.Error_View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Icon="/Resources/Images/SASLogo.png"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Title="Error">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Icon and Title -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0 0 0 10">
            <materialDesign:PackIcon Kind="AlertCircle" Foreground="Red" Width="40" Height="40"/>
            <TextBlock Text="Error!" FontFamily="{StaticResource PoppinsBold}" 
                       FontSize="24" VerticalAlignment="Center" Margin="10 0 0 0"/>
        </StackPanel>

        <!-- Message Text -->
        <TextBlock Grid.Row="1"
                   x:Name="MessageTextBlock"
                   Text="Something went wrong. Please try again or contact support." 
                   FontSize="14"
                   TextWrapping="Wrap"
                   Padding="10"
                   Margin="0"
                   ClipToBounds="False"
                   TextTrimming="None"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Justify"
                   Width="360"/>

        <!-- Button -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
            <Button x:Name="btnOkay"
                    Content="Okay"
                    Width="100"
                    FontFamily="{StaticResource PoppinsBold}"/>

        </StackPanel>
    </Grid>
</Window>
