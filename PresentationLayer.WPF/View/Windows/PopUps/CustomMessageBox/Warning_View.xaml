<Window x:Class="PresentationLayer.WPF.View.Windows.PopUps.CustomMessageBox.Warning_View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Title="Warning">

    <Grid Margin="20,10,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Icon and Title -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,0,10">
            <materialDesign:PackIcon Kind="WarningCircle"
                                     Foreground="Red"
                                     Width="40"
                                     Height="40"/>
            <TextBlock Text="Warning!"
                       FontFamily="{StaticResource PoppinsBold}"
                       FontSize="24"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Message Text -->
        <TextBlock Grid.Row="1"
                   x:Name="MessageTextBlock"
                   Text="Are you sure you want to proceed? This action cannot be undone and may affect system settings."
                   FontSize="14"
                   FontFamily="{StaticResource PoppinsRegular}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,10"
                   HorizontalAlignment="Center"
                   TextAlignment="Left"
                   Width="360"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button x:Name="btnCancel"
                    Content="Cancel"
                    Width="100"
                    Margin="0,0,10,0"
                    FontFamily="{StaticResource PoppinsBold}"/>
            <Button x:Name="btnOkay"
                    Content="Okay"
                    Width="100"
                    FontFamily="{StaticResource PoppinsBold}"/>
        </StackPanel>
    </Grid>
</Window>
