<Window x:Class="PresentationLayer.WPF.View.Windows.PopUps.CustomMessageBox.Warning_View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PresentationLayer.WPF.View.Windows.PopUps.CustomMessageBox" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        ResizeMode="NoResize"
    Height="277" 
    Width="366">
    <Grid Margin="10">

        <materialDesign:PackIcon Grid.Column="0" Grid.Row="0" 
                     Kind="WarningCircle" Foreground="Red" Width="50" Height="50"/>

        <TextBlock Text="Warning!" VerticalAlignment="Top"
        FontFamily="{StaticResource PoppinsBold}" FontSize="25" Margin="53,6,104,0"/>

        <Button Content="Okay" HorizontalAlignment="Left" Margin="246,169,0,0" VerticalAlignment="Top"
            FontFamily="{StaticResource PoppinsBold}" />

        <Button Content="Cancel" HorizontalAlignment="Left" Margin="141,169,0,0" VerticalAlignment="Top"
     FontFamily="{StaticResource PoppinsBold}" />



    </Grid>
</Window>
