<Window
    x:Class="PresentationLayer.WPF.View.Windows.PopUps.AttendanceRequestAction_View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:PresentationLayer.WPF.View.Windows.PopUps"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:userControls="clr-namespace:PresentationLayer.WPF.View.UserControls"
    mc:Ignorable="d"
    Height="600" Width="500" Icon="/Resources/Images/SASLogo.png"
    WindowStartupLocation="CenterScreen"
    Title="Attendance Request Action"
    ResizeMode="CanResize">

    <Viewbox>
        <Grid Height="600" Width="500">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height=".6*"/>
                </Grid.RowDefinitions>

                <!-- TITLE HEADER -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Kind="PersonCheck" Height="60" Width="60"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Attendance Request" VerticalAlignment="Center"
                               FontFamily="{StaticResource PoppinsBold}" FontSize="36"/>
                </Grid>

                <!-- EMPLOYEE INFO -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <userControls:LabeledTextBox Label="Employee Name" Text="{Binding EmployeeName}" IsEnabled="False"/>
                    <userControls:LabeledTextBox Grid.Column="2" Label="Employee ID" Text="{Binding EmployeeID}" IsEnabled="False"/>
                </Grid>

                <!-- DEPARTMENT -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <userControls:LabeledTextBox Label="Department" Text="{Binding Department}" IsEnabled="False"/>
                    <userControls:LabeledTextBox Grid.Column="2" Label="Role" Text="{Binding Role}" IsEnabled="False"/>
                </Grid>

                <!-- DATE & REASON -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Date" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="14"/>
                        <DatePicker SelectedDate="{Binding Date}" IsEnabled="False"
                                    FontFamily="{StaticResource PoppinsLight}" FontSize="12" Margin="0,5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Reason" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="14"/>
                        <TextBox Text="{Binding Reason}" IsReadOnly="True"
                                 FontFamily="{StaticResource PoppinsLight}" FontSize="12"
                                 Margin="0,5" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Grid>

                <!-- TIME IN/OUT/TOTAL -->
                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Time In" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="14"/>
                        <materialDesign:TimePicker SelectedTime="{Binding TimeIn}" IsEnabled="False"
                                                   FontFamily="{StaticResource PoppinsLight}" FontSize="12" Margin="0,5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Time Out" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="14"/>
                        <materialDesign:TimePicker SelectedTime="{Binding TimeOut}" IsEnabled="False"
                                                   FontFamily="{StaticResource PoppinsLight}" FontSize="12" Margin="0,5"/>
                    </StackPanel>

                    <userControls:LabeledTextBox Grid.Column="4" Label="Total Hours" Text="{Binding TotalHours}" IsEnabled="False"/>
                </Grid>

                <!-- BREAK INFO -->
                <Grid Grid.Row="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Break Start" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="14"/>
                        <materialDesign:TimePicker SelectedTime="{Binding BreakStart}" IsEnabled="False"
                                                   FontFamily="{StaticResource PoppinsLight}" FontSize="12" Margin="0,5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Break End" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="14"/>
                        <materialDesign:TimePicker SelectedTime="{Binding BreakEnd}" IsEnabled="False"
                                                   FontFamily="{StaticResource PoppinsLight}" FontSize="12" Margin="0,5"/>
                    </StackPanel>

                    <userControls:LabeledTextBox Grid.Column="4" Label="Break Total" Text="{Binding TotalBreakHours}" IsEnabled="False"/>
                </Grid>

                <!-- PROOF -->
                <Grid Grid.Row="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <userControls:LabeledTextBox Label="Proof" Text="{Binding ProofFiles}" IsEnabled="False"/>
                    <Button Grid.Column="2" Command="{Binding AttachFileCommand}" IsEnabled="True"
                            FontFamily="{StaticResource PoppinsSemiBold}"
                            Foreground="DarkGoldenrod"
                            Background="LightGoldenrodYellow"
                            BorderBrush="DarkGoldenrod"
                            BorderThickness="2"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="FolderOpen" Width="20" Height="20"/>
                    </Button>
                </Grid>

                <!-- ACTION BUTTONS -->
                <Grid Grid.Row="14" HorizontalAlignment="Right">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Approve"
                            FontFamily="{StaticResource PoppinsBold}" FontSize="12"
                            Width="110" Height="35"
                            HorizontalAlignment="Center"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="17.5"
                            Foreground="DarkGreen"
                            Background="LightGreen"
                            BorderBrush="DarkGreen"
                            Command="{Binding ApproveCommand}"/>

                    <Button Grid.Column="2"
                            Content="Disapprove"
                            FontFamily="{StaticResource PoppinsBold}" FontSize="12"
                            Width="110" Height="35"
                            HorizontalAlignment="Center"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="17.5"
                            Foreground="DarkRed"
                            Background="MistyRose"
                            BorderBrush="DarkRed"
                            Command="{Binding DisapproveCommand}"/>
                </Grid>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
