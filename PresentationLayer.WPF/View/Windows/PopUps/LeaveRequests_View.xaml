<Window x:Class="PresentationLayer.WPF.View.Windows.PopUps.LeaveRequests_View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:enum="clr-namespace:DomainLayer.Enums;assembly=DomainLayer"
        xmlns:helpers="clr-namespace:PresentationLayer.WPF.Helpers"
        xmlns:local="clr-namespace:PresentationLayer.WPF.View.Windows.PopUps"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:userControls="clr-namespace:PresentationLayer.WPF.View.UserControls"
        mc:Ignorable="d"
        Title="Leave Request"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/Images/SASLogo.png"
        ResizeMode="NoResize">

    <Viewbox>
        <Grid Width="800" Height="500">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height=".5*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Grid.Column="0"
                                             Kind="FileEye" Width="50" Height="50"
                                             VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text="Leave Request Viewer"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource PoppinsBold}"
                               FontSize="36"/>
                </Grid>

                <!-- EMPLOYEE DETAILS -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <userControls:LabeledTextBox x:Name="lbtbEmployeeName" Grid.Column="0" Label="Employee Name" IsEnabled="False" Text="{Binding EmployeeName}"/>
                    <userControls:LabeledTextBox x:Name="lbtbEmployeeID" Grid.Column="2" Label="Employee ID" IsEnabled="False" Text="{Binding EmployeeId}"/>
                    <userControls:LabeledTextBox x:Name="lbtbEmployeeDept" Grid.Column="4" Label="Department" IsEnabled="False" Text="{Binding Department}"/>
                </Grid>

                <!-- TYPE AND DURATION -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Leave Type" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="16" Margin="0,0,0,10"/>
                        <ComboBox x:Name="cbLeaveType"
                                  FontFamily="{StaticResource PoppinsRegular}"
                                  FontSize="14" Margin="0,0,0,10"
                                  ItemsSource="{helpers:EnumBindingSource enum:LeaveType}"
                                  SelectedItem="{Binding SelectedLeaveType}"
                                  IsEnabled="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Duration (Number of Days)" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="16" Margin="0,0,0,10"/>
                        <materialDesign:NumericUpDown x:Name="nudDuration"
                                                      FontFamily="{StaticResource PoppinsRegular}"
                                                      FontSize="14"
                                                      Value="{Binding Duration}"
                                                      IsEnabled="True"/>
                    </StackPanel>
                </Grid>

                <!-- FROM - TO -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Start Date" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="16" Margin="0,0,0,10"/>
                        <DatePicker x:Name="dpStartDate"
                                    FontFamily="{StaticResource PoppinsRegular}"
                                    FontSize="14"
                                    SelectedDate="{Binding StartDate}"
                                    IsEnabled="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Return Date" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="16" Margin="0,0,0,10"/>
                        <DatePicker x:Name="dpReturnDate"
                                    FontFamily="{StaticResource PoppinsRegular}"
                                    FontSize="14"
                                    SelectedDate="{Binding ReturnDate}"
                                    IsEnabled="True"/>
                    </StackPanel>
                </Grid>

                <!-- ATTACHMENTS -->
                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <userControls:LabeledTextBox Grid.Column="0" Label="Attachments" Text="Insert Path" IsEnabled="False"/>

                    <Button Grid.Column="2"
                            FontFamily="{StaticResource PoppinsSemiBold}"
                            Background="LightGoldenrodYellow"
                            Foreground="DarkGoldenrod"
                            BorderBrush="DarkGoldenrod"
                            BorderThickness="2"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="FolderOpen" Width="20" Height="20" Foreground="DarkGoldenrod"/>
                    </Button>
                </Grid>

                <!-- APPROVE / DISAPPROVE -->
                <Grid Grid.Row="10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Approve"
                                FontFamily="{StaticResource PoppinsBold}" FontSize="12"
                                Width="110" Height="35"
                                Background="LightGreen"
                                Foreground="DarkGreen"
                                BorderBrush="DarkGreen"
                                BorderThickness="2"
                                Command="{Binding Approve}"
                                materialDesign:ButtonAssist.CornerRadius="17.5"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Margin="0,0,20,0"/>

                        <Button Content="Disapprove"
                                FontFamily="{StaticResource PoppinsBold}" FontSize="12"
                                Width="110" Height="35"
                                Background="LightPink"
                                Foreground="DarkRed"
                                BorderBrush="DarkRed"
                                BorderThickness="2"
                                Command="{Binding Disapprove}"
                                materialDesign:ButtonAssist.CornerRadius="17.5"
                                Style="{StaticResource MaterialDesignRaisedButton}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
