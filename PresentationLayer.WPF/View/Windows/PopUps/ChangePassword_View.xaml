<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PresentationLayer.WPF.View.Windows.PopUps" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:UserControls="clr-namespace:PresentationLayer.WPF.View.UserControls" xmlns:UserControls1="clr-namespace:SASPayrolSystemProject.View.UserControls" x:Class="PresentationLayer.WPF.View.Windows.PopUps.ChangePassword_View"
        mc:Ignorable="d"
        Title="Change Password" 
        Icon="/Resources/Images/SASLogo.png"
        Height="350" 
        Width="370"
        ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height=".5*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Kind="Lock" Foreground="Black" Width="40" Height="40"/>
                <TextBlock Grid.Column="1" Text="Change Password" VerticalAlignment="Top"
                    FontFamily="{StaticResource PoppinsBold}" FontSize="26" RenderTransformOrigin="0.504,0.135" Margin="2,2,8,0" Grid.ColumnSpan="2"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="23*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="35*"/>
                </Grid.ColumnDefinitions>

                <Label Content="Current Password:" HorizontalAlignment="Center" VerticalAlignment="Center" Height="35" Width="125" FontFamily="{StaticResource PoppinsBold}" FontSize="12" />
                <UserControls1:CustomPasswordBox Grid.Column="2" HorizontalAlignment="Left" Margin="0,1,0,0" VerticalAlignment="Top" Width="192"/>
            </Grid>
        </Grid>


        <Grid Grid.Row="4">
            <Grid>
                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="23*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="35*"/>
                </Grid.ColumnDefinitions>

                <Label Content="New Password:" HorizontalAlignment="Center" VerticalAlignment="Center" Height="35" Width="125" FontFamily="{StaticResource PoppinsBold}" FontSize="12" />
                <UserControls1:CustomPasswordBox Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Top" Width="192"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="6">
            <Grid>
                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="23*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="35*"/>
                </Grid.ColumnDefinitions>

                <Label Content="Confirm Password:" HorizontalAlignment="Center" VerticalAlignment="Center" Height="35" Width="125" FontFamily="{StaticResource PoppinsBold}" FontSize="12" />
                <UserControls1:CustomPasswordBox Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Top" Width="192"/>
            </Grid>
        </Grid>


        <Grid Grid.Row="8">
            <Button Content="Cancel" HorizontalAlignment="Left" Margin="50,10,0,0" VerticalAlignment="Top" Width="90"/>
            <Button Content="OK" HorizontalAlignment="Left" Margin="179,10,0,0" VerticalAlignment="Top" Width="90"/>





        </Grid>


    </Grid>
</Window>
