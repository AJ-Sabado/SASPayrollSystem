<Window x:Class="PresentationLayer.WPF.View.Windows.PopUps.OnboardingRequest_View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PresentationLayer.WPF.View.Windows.PopUps"
        
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:userControls="clr-namespace:PresentationLayer.WPF.View.UserControls"

        mc:Ignorable="d"
        Icon="/Resources/Images/SASLogo.png"
        Title="Onboarding Request" Height="650" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid>
        <Grid Margin="30,20,30,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="38*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="38*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="38*"/>
                <RowDefinition Height="38*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="38*"/>
                <RowDefinition Height="38*"/>
                <RowDefinition Height="21*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="Worker" Width="40" Height="40"/>
                <TextBlock Grid.Column="2" Text="   Employee Onboarding" VerticalAlignment="Center"
                         FontFamily="{StaticResource PoppinsBold}" FontSize="28"/>
            </StackPanel>


            <Grid Grid.Row="2" Margin="0,5,0,0" Grid.RowSpan="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <userControls:LabeledTextBox  Grid.Column="0" Label="First Name" Text="{Binding FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <userControls:LabeledTextBox  Grid.Column="2" Label="M. I." Text="{Binding MiddleInitial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <userControls:LabeledTextBox  Grid.Column="4" Label="Last Name" Text="{Binding LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>


            
            <userControls:LabeledTextBox Grid.Row="4" Label="Account Username" 
                          Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,76" Grid.RowSpan="2"/>

            <userControls:LabeledTextBox Grid.Row="5" Label="Email" 
                        Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,76" Grid.RowSpan="3"/>

            <!--DEPT AND ROLES-->
            <Grid Grid.Row="7" Margin="0,0,0,42" Grid.RowSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Department" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="14" Margin="2"/>
                    <ComboBox x:Name="cbDepartment" FontFamily="{StaticResource PoppinsLight}" FontSize="12" Margin="2" 
                              ItemsSource="{Binding Departments}"
                              SelectedItem="{Binding SelectedDepartment}"
                              DisplayMemberPath="Name"
                              />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Role" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="14" Margin="2"/>
                    <ComboBox x:Name="cbRole" FontFamily="{StaticResource PoppinsLight}" FontSize="12" Margin="2" 
                              ItemsSource="{Binding Roles}"
                              SelectedItem="{Binding SelectedRole}"
                              DisplayMemberPath="Name"
                              />
                </StackPanel>
            </Grid>

            <userControls:LabeledTextBox Grid.Row="8" Label="Job Title" 
            Text="{Binding JobTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,76" Grid.RowSpan="3"/>

            <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="320,0,0,0">
                <Button x:Name="btnApproveEmployee" Content="Approve" 
                        FontFamily="{StaticResource PoppinsBold}" FontSize="12" 
                        HorizontalAlignment="Center"
                        Width="110" Height="35"
                        materialDesign:ButtonAssist.CornerRadius="17.5"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,5,0"
                        Foreground="DarkGoldenrod"
                        Background="LightGoldenrodYellow"
                        Command="{Binding Approve}"
                        BorderBrush="DarkGoldenrod"/>
                <Button x:Name="btnCancel" Content="Cancel" 
                        FontFamily="{StaticResource PoppinsBold}" FontSize="12" 
                        HorizontalAlignment="Center"
                        Width="100" Height="35"
                        materialDesign:ButtonAssist.CornerRadius="17.5"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="5,0,0,0" Click="btnCancel_Click"
                        BorderBrush="DarkGoldenrod"
                        Command="{Binding Cancel}"
                        Foreground="DarkGoldenrod"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
