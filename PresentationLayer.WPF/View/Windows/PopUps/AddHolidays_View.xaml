<Window x:Class="PresentationLayer.WPF.View.Windows.PopUps.AddHolidays_View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PresentationLayer.WPF.View.Windows.PopUps"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:userControls="clr-namespace:PresentationLayer.WPF.View.UserControls"
        mc:Ignorable="d"
        Title="Add Holiday"
        Height="450" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/Resources/Images/SASLogo.png">

    <Grid Margin="30,20,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height=".7*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <materialDesign:PackIcon Kind="CalendarPlus" Width="40" Height="40"/>
            <TextBlock Text="   Add Holiday" VerticalAlignment="Center"
                       FontFamily="{StaticResource PoppinsBold}" FontSize="28"/>
        </StackPanel>

        <!-- Holiday Name -->
        <userControls:LabeledTextBox Grid.Row="2" Label="Holiday Name" Text="Holiday Name"/>

        <!-- Holiday Date -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="Holiday Date" 
                       FontFamily="{StaticResource PoppinsMedium}" 
                       FontSize="14" Margin="0,0,0,5"/>
            <DatePicker x:Name="dateHoliday" 
                        Style="{StaticResource MaterialDesignDatePicker}"
                        FontSize="14"/>
        </StackPanel>

        <!-- Description -->
        <StackPanel Grid.Row="6">
            <TextBlock Text="Description" 
                       FontFamily="{StaticResource PoppinsMedium}" 
                       FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="txtDescription"
                     AcceptsReturn="True" Height="90"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     FontSize="14" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button x:Name="btnSaveHoliday" Content="Save" 
                    FontFamily="{StaticResource PoppinsBold}" FontSize="12" 
                    Width="100" Height="35"
                    materialDesign:ButtonAssist.CornerRadius="17.5"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="0,0,10,0"
                    Foreground="DarkGoldenrod"
                    Background="LightGoldenrodYellow"
                    BorderBrush="DarkGoldenrod"/>

            <Button x:Name="btnCancel" Content="Cancel" 
                    FontFamily="{StaticResource PoppinsBold}" FontSize="12" 
                    Width="100" Height="35"
                    materialDesign:ButtonAssist.CornerRadius="17.5"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Margin="5,0,0,0"
                    BorderBrush="DarkGoldenrod"
                    Foreground="DarkGoldenrod"/>
        </StackPanel>
    </Grid>
</Window>
