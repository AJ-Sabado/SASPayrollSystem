<Window x:Class="PresentationLayer.WPF.View.Windows.PopUps.AssignLeave_View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:enum="clr-namespace:DomainLayer.Enums;assembly=DomainLayer"
        xmlns:helpers="clr-namespace:PresentationLayer.WPF.Helpers"
        xmlns:local="clr-namespace:PresentationLayer.WPF.View.Windows.PopUps"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:userControls="clr-namespace:PresentationLayer.WPF.View.UserControls"
        mc:Ignorable="d"
        Title="Assign Leave" Height="500" Width="820"
        Icon="/Resources/Images/SASLogo.png"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Viewbox>
        <Grid Width="800" Height="450">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height=".6*"/>
                </Grid.RowDefinitions>

                <!-- Header Title -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Grid.Column="0"
                                             Kind="CalendarAccount"
                                             Width="50" Height="50"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2" Text="Assign Leave"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource PoppinsBold}"
                               FontSize="36"/>
                </Grid>

                <!-- Employee Details -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <userControls:LabeledTextBox x:Name="lbtbEmployeeName" Grid.Column="0" Label="Employee Name" Text="{Binding EmployeeName}"/>
                    <userControls:LabeledTextBox x:Name="lbtbEmployeeID" Grid.Column="2" Label="Employee ID" Text="{Binding EmployeeId}"/>
                    <userControls:LabeledTextBox x:Name="lbtbEmployeeDept" Grid.Column="4" Label="Department" Text="{Binding Department}"/>
                </Grid>

                <!-- Type & Duration -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Leave Type" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="16" Margin="0,0,0,10"/>
                        <ComboBox x:Name="cbLeaveType"
                                  FontFamily="{StaticResource PoppinsRegular}"
                                  FontSize="14" Margin="0,0,0,10"
                                  ItemsSource="{helpers:EnumBindingSource enum:LeaveType}"
                                  SelectedItem="{Binding SelectedLeaveType}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Duration (Number of Days)" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="16" Margin="0,0,0,10"/>
                        <materialDesign:NumericUpDown x:Name="nudDuration"
                                                      FontFamily="{StaticResource PoppinsRegular}"
                                                      FontSize="14" Margin="0,0,0,10"
                                                      Minimum="0"
                                                      Value="{Binding Duration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- Start & Return Dates -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Start Date" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="16" Margin="0,0,0,10"/>
                        <DatePicker x:Name="dpStartDate"
                                    FontFamily="{StaticResource PoppinsRegular}"
                                    FontSize="14" Margin="0,0,0,10"
                                    SelectedDate="{Binding StartDate}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Return Date" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="16" Margin="0,0,0,10"/>
                        <DatePicker x:Name="dpReturnDate"
                                    FontFamily="{StaticResource PoppinsRegular}"
                                    FontSize="14" Margin="0,0,0,10"
                                    SelectedDate="{Binding ReturnDate}"/>
                    </StackPanel>
                </Grid>

                <!-- Apply & Cancel Buttons -->
                <Grid Grid.Row="8" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnApply"
                            Grid.Column="0"
                            Content="Assign"
                            FontFamily="{StaticResource PoppinsBold}" FontSize="12"
                            Width="110" Height="40"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="20"
                            Foreground="DarkGoldenrod"
                            Background="LightGoldenrodYellow"
                            BorderBrush="DarkGoldenrod"
                            BorderThickness="2"
                            Command="{Binding Assign}"/>

                    <Button x:Name="btnCancel"
                            Grid.Column="2"
                            Content="Cancel"
                            FontFamily="{StaticResource PoppinsBold}" FontSize="12"
                            Width="110" Height="40"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            materialDesign:ButtonAssist.CornerRadius="20"
                            Foreground="DarkGoldenrod"
                            BorderBrush="DarkGoldenrod"
                            BorderThickness="2"
                            Command="{Binding Cancel}"/>
                </Grid>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
