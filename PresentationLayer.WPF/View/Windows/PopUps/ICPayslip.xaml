<Window x:Class="PresentationLayer.WPF.View.Windows.PopUps.ICPayslip"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Payslip"
        Height="600" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/Resources/Images/SASLogo.png">

    <DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" DockPanel.Dock="Top">
            <StackPanel Margin="30,20,30,20">

                <!-- Header -->
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Payslip" FontFamily="{StaticResource PoppinsBold}" FontSize="24" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1">
                        <Button x:Name="btnPreviewPayslip" 
                                FontFamily="{StaticResource PoppinsBold}" FontSize="12"
                                Width="100" Height="35"
                                materialDesign:ButtonAssist.CornerRadius="17.5"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="DarkGoldenrod"
                                Foreground="DarkGoldenrod"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Eye" Margin="0,0,5,0"/>
                                <TextBlock Text="Preview"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnPrintPayslip" 
                                FontFamily="{StaticResource PoppinsBold}" FontSize="12"
                                Width="100" Height="35"
                                materialDesign:ButtonAssist.CornerRadius="17.5"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="DarkGoldenrod"
                                Foreground="DarkGoldenrod">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Printer" Margin="0,0,5,0"/>
                                <TextBlock Text="Print"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,10"/>

                <!-- Hourly Rate -->
                <Grid Margin="10,5,10,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Hourly Rate" FontFamily="{StaticResource PoppinsRegular}" FontSize="16" Grid.Column="0"/>
                    <TextBlock Text="{Binding HourlyRate}" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="16" HorizontalAlignment="Right" Grid.Column="1"/>
                </Grid>

                <!-- Total Hours Rendered -->
                <Grid Margin="10,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Total Hours Rendered" FontFamily="{StaticResource PoppinsRegular}" FontSize="16" Grid.Column="0"/>
                    <TextBlock Text="{Binding TotalHoursRendered}" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="16" HorizontalAlignment="Right" Grid.Column="1"/>
                </Grid>

                <Separator Margin="0,10"/>

                <!-- Gross Pay -->
                <Grid Margin="10,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Gross Pay" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="18" Grid.Column="0"/>
                    <TextBlock Text="{Binding GrossPay}" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="18" HorizontalAlignment="Right" Grid.Column="1"/>
                </Grid>

                <Separator Margin="0,10"/>

                <!-- Deductions -->
                <TextBlock Text="Deductions and Contributions" FontFamily="{StaticResource PoppinsBold}" FontSize="18" Margin="0,10,0,5"/>
                <Grid Margin="10,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="N/A" FontFamily="{StaticResource PoppinsRegular}" FontSize="16" Grid.Column="0"/>
                    <TextBlock Text="₱0.00" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="16" HorizontalAlignment="Right" Grid.Column="1"/>
                </Grid>

                <Separator Margin="0,10"/>

                <!-- Net Salary -->
                <Grid Margin="10,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Net Salary" FontFamily="{StaticResource PoppinsBold}" FontSize="18" Foreground="DarkGreen" Grid.Column="0"/>
                    <TextBlock Text="{Binding NetSalary}" FontFamily="{StaticResource PoppinsBold}" FontSize="18" Foreground="DarkGreen" HorizontalAlignment="Right" Grid.Column="1"/>
                </Grid>

                <Separator Margin="0,10"/>

                <!-- Payroll Date and Status -->
                <Grid Margin="10,5,10,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Payroll Date" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="12" Grid.Column="0"/>
                    <TextBlock Text="{Binding PayrollDate}" FontFamily="{StaticResource PoppinsRegular}" FontSize="12" HorizontalAlignment="Right" Grid.Column="1"/>
                </Grid>

                <Grid Margin="10,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Payroll Status" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="12" Grid.Column="0"/>
                    <TextBlock Text="{Binding PayrollStatus}" FontFamily="{StaticResource PoppinsRegular}" FontSize="12" HorizontalAlignment="Right" Grid.Column="1"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
