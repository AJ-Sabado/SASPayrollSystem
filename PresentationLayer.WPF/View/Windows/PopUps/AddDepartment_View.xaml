<Window x:Class="PresentationLayer.WPF.View.Windows.PopUps.AddDepartment_View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PresentationLayer.WPF.View.Windows.PopUps"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:userControls="clr-namespace:PresentationLayer.WPF.View.UserControls"
        mc:Ignorable="d"
        Title="Add Department"
        Height="300" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/Resources/Images/SASLogo.png">

    <Grid Margin="30,20,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <materialDesign:PackIcon Kind="OfficeBuilding" Width="40" Height="40"/>
            <TextBlock Text="   Add Department" VerticalAlignment="Center"
                       FontFamily="{StaticResource PoppinsBold}" FontSize="28"/>
        </StackPanel>

        <!-- Department Name -->
        <userControls:LabeledTextBox Grid.Row="2" Label="Department Name" Text="Department Name"/>

        <!-- Department Code -->
        <userControls:LabeledTextBox Grid.Row="4" Label="Department Code" Text="Code"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,0">
            <Button x:Name="btnAddDepartment" Content="Add" 
                    FontFamily="{StaticResource PoppinsBold}" FontSize="12" 
                    Width="100" Height="35"
                    materialDesign:ButtonAssist.CornerRadius="17.5"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="0,0,10,0"
                    Foreground="DarkGoldenrod"
                    Background="LightGoldenrodYellow"
                    BorderBrush="DarkGoldenrod"/>

            <Button x:Name="btnCancel" Content="Cancel" 
                    FontFamily="{StaticResource PoppinsBold}" FontSize="12" 
                    Width="100" Height="35"
                    materialDesign:ButtonAssist.CornerRadius="17.5"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Margin="5,0,0,0"
                    BorderBrush="DarkGoldenrod"
                    Foreground="DarkGoldenrod"/>
        </StackPanel>
    </Grid>
</Window>
