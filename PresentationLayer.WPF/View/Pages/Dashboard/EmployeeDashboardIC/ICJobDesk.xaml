<UserControl x:Class="PresentationLayer.WPF.View.Pages.Dashboard.EmployeeDashboardIC.ICJobDesk"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PresentationLayer.WPF.View.Pages.Dashboard.EmployeeDashboardIC"
             mc:Ignorable="d" 
             d:DesignHeight="688" d:DesignWidth="1088"
             
              xmlns:userControls="clr-namespace:PresentationLayer.WPF.View.Pages.Dashboard.EmployeeDashboardReg"
                          xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             >

    <Viewbox>
        <Grid x:Name="Canvas" Height="688" Width="1088">
            <Grid x:Name="Base" Margin="20" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="7*"/>
                    <RowDefinition Height="93*"/>
                </Grid.RowDefinitions>

                <!---TITLE-->
                <TextBlock Grid.Row="0" Text="JOB DESK" 
                FontFamily="{StaticResource PoppinsBold}" 
                FontSize="30" Foreground="Black" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <!--JOBDESK AREA-->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30*"/>
                        <ColumnDefinition Width="70*"/>
                    </Grid.ColumnDefinitions>

                    <!--EMPLOYEE INFO SUMMARY-->
                    <materialDesign:Card Grid.Column="0" HorizontalAlignment="Stretch" 
                                VerticalAlignment="Stretch" Background="White" UniformCornerRadius="10" BorderBrush="LightGray" 
                                BorderThickness="1" Effect="{StaticResource CardEffects}" Margin="0,0,7,0">
                        <Grid Margin="20,15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="11*"/>
                                <RowDefinition Height="6*"/>
                                <RowDefinition Height="11*"/>
                                <RowDefinition Height="11*"/>
                                <RowDefinition Height="11*"/>
                                <RowDefinition Height="11*"/>
                                <RowDefinition Height="6*"/>
                                <RowDefinition Height="11*"/>
                                <RowDefinition Height="11*"/>
                                <RowDefinition Height="11*"/>
                            </Grid.RowDefinitions>

                            <!--EMPLOYEE DETAILS-->
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal">
                                    <Image Grid.Column="0" x:Name="imgProfilePicture" Source="/Resources/Images/Profile.jpg" 
                                            Height="46" Width="46" Stretch="UniformToFill"
                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image.Clip>
                                            <EllipseGeometry RadiusX="23" RadiusY="23" Center="23,23"/>
                                        </Image.Clip>
                                    </Image>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtEmployeeName" Text="{Binding FullName}"
                                                    FontFamily="{StaticResource PoppinsSemiBold}" FontSize="16"
                                                     HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtEmployeePosition" Text="{Binding Role}"
                                                    FontFamily="{StaticResource PoppinsLight}" FontSize="12"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    </StackPanel>


                                </StackPanel>

                            </Grid>

                            <!--INFORMATION-->
                            <TextBlock Grid.Row="1" Text="Info" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="18" Padding="0,5"/>

                            <!--DEPARTMENT-->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2" HorizontalAlignment="Left" VerticalAlignment="Center">

                                <Border Background="#e6e6e6" Height="Auto" Width="auto" CornerRadius="5" Padding="3">
                                    <materialDesign:PackIcon Kind="Building" 
                                                            Width="40" Height="40" 
                                                            VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtEmployeeDepartment" Text="{Binding Department}"
                                                FontFamily="{StaticResource PoppinsSemiBold}" FontSize="16"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Text="Department"
                                                FontFamily="{StaticResource PoppinsLight}" FontSize="12"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!--EMPLOYMENT STATUS-->
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,2" HorizontalAlignment="Left" VerticalAlignment="Center">

                                <Border Background="#e6e6e6" Height="Auto" Width="auto" CornerRadius="5" Padding="3">
                                    <materialDesign:PackIcon Kind="BriefcaseCheckOutline" 
                                                            Width="40" Height="40" 
                                                            VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtEmployeeStatus" Text="{Binding EmploymentStatus}"
                                                FontFamily="{StaticResource PoppinsSemiBold}" FontSize="16"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Text="Employment Status"
                                                FontFamily="{StaticResource PoppinsLight}" FontSize="12"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!--Weekly Shift-->
                            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,2" HorizontalAlignment="Left" VerticalAlignment="Center">

                                <Border Background="#e6e6e6" Height="Auto" Width="auto" CornerRadius="5" Padding="3">
                                    <materialDesign:PackIcon Kind="CalendarWeek" 
                                                             Width="40" Height="40" 
                                                                VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtEmployeeShift" Text="{Binding WeeklyTarget}"
                                                FontFamily="{StaticResource PoppinsSemiBold}" FontSize="16"
                                                 HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Text="Weekly Target"
                                                FontFamily="{StaticResource PoppinsLight}" FontSize="12"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!--Rate-->
                            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,2" HorizontalAlignment="Left" VerticalAlignment="Center">

                                <Border Background="#e6e6e6" Height="Auto" Width="auto" CornerRadius="5" Padding="3">
                                    <materialDesign:PackIcon Kind="Clockwise" 
                                                            Width="40" Height="40" 
                                                            VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtEmployeeRate" Text="{Binding HourlyRate}"
                                                    FontFamily="{StaticResource PoppinsSemiBold}" FontSize="16"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Text="Hourly Rate"
                                                FontFamily="{StaticResource PoppinsLight}" FontSize="12"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!--INFORMATION-->
                            <TextBlock Grid.Row="6" Text="Contacts" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="18" Padding="0,5"/>

                            <!--Email-->
                            <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border Background="Transparent" Height="Auto" Width="auto" CornerRadius="5" Padding="3">
                                    <materialDesign:PackIcon Kind="AlternateEmail" 
                                                             Width="40" Height="40" 
                                                            VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="Email"
                                                FontFamily="{StaticResource PoppinsSemiBold}" FontSize="16"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock  x:Name="txtEmployeeEmail" Text="{Binding Email}"
                                                FontFamily="{StaticResource PoppinsLight}" FontSize="12"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!--Phone-->
                            <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border Background="Transparent" Height="Auto" Width="auto" CornerRadius="5" Padding="3">
                                    <materialDesign:PackIcon Kind="Cellphone" 
                                                                Width="40" Height="40" 
                                                                VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock  Text="Phone"
                                                FontFamily="{StaticResource PoppinsSemiBold}" FontSize="16"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtEmployeePhoneNumber" Text="{Binding Phone}"
                                                FontFamily="{StaticResource PoppinsLight}" FontSize="12"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!--Website-->
                            <StackPanel Grid.Row="9" Orientation="Horizontal" Margin="0,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border Background="Transparent" Height="Auto" Width="auto" CornerRadius="5" Padding="3">
                                    <materialDesign:PackIcon Kind="Web" 
                                                             Width="40" Height="40" 
                                                            VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="Website"
                                                FontFamily="{StaticResource PoppinsSemiBold}" FontSize="16"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock  x:Name="txtEmployeeWebsite" Text="{Binding Website}"
                                                FontFamily="{StaticResource PoppinsLight}" FontSize="12"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                        </Grid>
                    </materialDesign:Card>


                    <!--JOBDESK-->
                    <materialDesign:Card Grid.Column="1" HorizontalAlignment="Stretch" 
                                VerticalAlignment="Stretch" Background="White" UniformCornerRadius="10" BorderBrush="LightGray" 
                                BorderThickness="1" Effect="{StaticResource CardEffects}" Margin="7,0,0,0">

                        <Grid>
                            <TabControl>
                                <TabControl.Resources>
                                    <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                                        <Setter Property="HeaderTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" 
                                                                FontSize="10" 
                                                                VerticalAlignment="Center"
                                                                TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TabControl.Resources>

                                <!--PAYSLIP-->
                                <TabItem Header="Payslip">
                                    <StackPanel Margin="30,10,30,20">
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Payslip" FontFamily="{StaticResource PoppinsSemiBold}"
                                                        FontSize="24" Width="515"/>
                                            <!--BUTTONS-->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Name="btnPreviewPayslip" Content="Preview" FontFamily="{StaticResource PoppinsMedium}"
                                                        FontSize="10" Height="25" Width="71" Foreground="White"/>
                                                <Button Name="btnPrintPayslip" Content="Print" FontFamily="{StaticResource PoppinsMedium}"
                                                        FontSize="10" Height="25" Width="71" Foreground="White" Margin="10,0,10,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <!--RATE-->
                                        <Grid Margin="10,5,10,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Hourly Rate" FontFamily="{StaticResource PoppinsRegular}" FontSize="16"/>
                                            <TextBlock Grid.Column="1" x:Name="txtPayslipHourlyRate" Text="{Binding HourlyRate}" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="16" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <!--TOTAL HOURS RENDERED-->
                                        <Grid Margin="10,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Total Hours Rendered" FontFamily="{StaticResource PoppinsRegular}" FontSize="16"/>
                                            <TextBlock Grid.Column="1" x:Name="txtEmployeeBonus" Text="{Binding TotalHoursRendered}" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="16" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Rectangle Fill="Gray" Height="0.5" Margin="0,2"/>

                                        <!--GROSS PAY-->
                                        <Grid Margin="10,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Gross Pay" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="18" Foreground="{StaticResource BaseColorSCB}"/>
                                            <TextBlock Grid.Column="1" x:Name="txtEmployeeGrossPay" Text="{Binding GrossPay}" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="18" Foreground="{StaticResource BaseColorSCB}" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Rectangle Fill="Gray" Height="0.5" Margin="0,2"/>

                                        <!--DEDUCTIONS-->
                                        <TextBlock Margin="10,3" Text="Deductions And Contributions" FontFamily="{StaticResource PoppinsBold}" FontSize="16"/>

                                        <!--DEDUCTION 1-->
                                        <Grid Margin="10,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="N/A" FontFamily="{StaticResource PoppinsRegular}" FontSize="16"/>
                                            <TextBlock Grid.Column="1" x:Name="txtEmployeeSalaryTax" Text="Php 0.00" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="16" HorizontalAlignment="Right"/>
                                        </Grid>

                                        

                                        <Rectangle Fill="Gray" Height="0.5" Margin="0,2"/>

                                        <!--Net Salary-->
                                        <Grid Margin="10,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Net Salary" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="16" Foreground="DarkGreen"/>
                                            <TextBlock Grid.Column="1" x:Name="txtEmployeeNetSalary" Text="{Binding NetSalary}" FontFamily="{StaticResource PoppinsSemiBold}" Foreground="DarkGreen" FontSize="16" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Rectangle Fill="Gray" Height="0.5" Margin="0,2"/>

                                        <!--Payroll Date-->
                                        <Grid Margin="10,5,10,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Payroll Date" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="10"/>
                                            <TextBlock Grid.Column="1" x:Name="txtPayrollDate" Text="{Binding PayrollDate}" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="10" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <!--Payroll Status-->
                                        <Grid Margin="10,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Payroll Status" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="10"/>
                                            <TextBlock Grid.Column="1" x:Name="txtPayrollStatus" Text="{Binding PayrollStatus}" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="10" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </TabItem>




                                <!--ATTENDANCE-->
                                <TabItem Header="Attendance">
                                    <Grid Margin="30,10,30,20">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="70*"/>
                                            <RowDefinition Height="3"/>
                                            <RowDefinition Height="30*"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0">
                                            <TextBlock Text="Attendance Log" FontFamily="{StaticResource PoppinsSemiBold}"
                                                        FontSize="20" />

                                            <!--ATTENDANCE LOG DATAGRID-->
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                <DataGrid x:Name="dataGridJobDeskAttendanceLog" AutoGenerateColumns="False"
                                                            Height="296"
                                                            CanUserResizeColumns="False"
                                                            Margin="0,5,0,5"
                                                            EnableRowVirtualization="True"
                                                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                            ItemsSource="{Binding AttendanceLogList, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                                            IsReadOnly="True"
                                                            Style="{StaticResource MaterialDesignDataGrid}" Width="665">

                                                    <DataGrid.Resources>
                                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                                            <Setter Property="FontSize" Value="9"/>

                                                        </Style>
                                                    </DataGrid.Resources>

                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Date" Width="*" Binding="{Binding Date}"/>
                                                        <DataGridTextColumn Header="Time In" Width="*" Binding="{Binding TimeIn, StringFormat='{}{0:hh:mm:ss tt}'}"/>
                                                        <DataGridTextColumn Header="Time Out" Width="*" Binding="{Binding TimeOut, StringFormat='{}{0:hh:mm:ss tt}'}"/>
                                                        <DataGridTextColumn Header="Duration" Width="*" Binding="{Binding Duration, StringFormat=F2}"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </ScrollViewer>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2">
                                            <TextBlock Text="Summary"
                                                        FontFamily="{StaticResource PoppinsSemiBold}" FontSize="16"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,10,0,0"/>

                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Total Hours Taken"
                                                                FontFamily="{StaticResource PoppinsMedium}" FontSize="16"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding SummaryTotalHoursTaken}"
                                                                FontFamily="{StaticResource PoppinsRegular}" FontStyle="Italic" FontSize="14"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Total Hours Remaining"
                                                                FontFamily="{StaticResource PoppinsMedium}" FontSize="16"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding SummaryTotalHoursRemaining}"
                                                                FontFamily="{StaticResource PoppinsRegular}" FontStyle="Italic" FontSize="14"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Average Daily Hours"
                                                                FontFamily="{StaticResource PoppinsMedium}" FontSize="16"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding SummaryAverageDailyHours}"
                                                                FontFamily="{StaticResource PoppinsRegular}" FontStyle="Italic" FontSize="14"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Longest Session"
                                                                FontFamily="{StaticResource PoppinsMedium}" FontSize="16"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding SummaryLongestSession}"
                                                                FontFamily="{StaticResource PoppinsRegular}" FontStyle="Italic" FontSize="14"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                    </Grid>
                                </TabItem>
                            </TabControl>


                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
