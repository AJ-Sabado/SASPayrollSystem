<UserControl x:Class="PresentationLayer.WPF.View.Pages.Dashboard.EmployeeDashboardIC.ICDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PresentationLayer.WPF.View.Pages.Dashboard.EmployeeDashboardIC"
             mc:Ignorable="d" 
             d:DesignHeight="688" d:DesignWidth="1088"
             
             xmlns:userControls="clr-namespace:PresentationLayer.WPF.View.Pages.Dashboard.EmployeeDashboardReg"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             >
    <Viewbox>
        <Grid x:Name="Canvas" Height="688" Width="1088">
            <Grid x:Name="Base" Margin="15" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="7*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="78*"/>
                </Grid.RowDefinitions>

                <!---TITLE-->
                <TextBlock Grid.Row="0" Text="DASHBOARD" 
                       FontFamily="{StaticResource PoppinsBold}" 
                       FontSize="30" Foreground="Black" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <!--EMPLOYEE DETAILS-->
                <materialDesign:Card Grid.Row="1" HorizontalAlignment="Stretch" Margin="0,10" 
                        VerticalAlignment="Stretch" Background="White" UniformCornerRadius="10" BorderBrush="LightGray" 
                        BorderThickness="1" Effect="{StaticResource CardEffects}">
                    <Grid Margin="20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" >
                            <StackPanel Orientation="Horizontal" >
                                <TextBlock Text="Welcome Back, " FontFamily="{StaticResource PoppinsSemiBold}" FontSize="25" />
                                <TextBlock Name="txtEmployeeFirstName" Text="{Binding EmployeeFirstName, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="25"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Name="txtEmployeeID" Text="{Binding EmployeeCompanyId, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                                        FontFamily="{StaticResource PoppinsLight}" FontSize="14" 
                                        FontStyle="Italic"/>

                                <TextBlock Text="   |   " 
                                       FontFamily="{StaticResource PoppinsLight}" FontSize="14" 
                                       FontStyle="Italic"/>

                                <TextBlock Name="txtEmployeePosition" Text="{Binding EmployeeRole, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                                       FontFamily="{StaticResource PoppinsLight}" FontSize="14" 
                                       FontStyle="Italic"/>
                            </StackPanel>
                        </StackPanel>

                        <!--SING OUT BUTTON-->
                        <Button Grid.Column="1" x:Name="btnLogOut"  Style="{StaticResource HeaderButtons}" 
                            Height="30" Width="30" HorizontalAlignment="Right"
                            Command="{Binding Logout}">
                            <materialDesign:PackIcon Kind="SignOutVariant" Height="20" Width="20"/>
                        </Button>


                    </Grid>
                </materialDesign:Card>


                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20*"/>
                        <ColumnDefinition Width="30*"/>
                        <ColumnDefinition Width="30*"/>
                    </Grid.ColumnDefinitions>

                    <!--SUMMARY CARDS-->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38*"/>
                            <RowDefinition Height="24*"/>
                            <RowDefinition Height="24*"/>
                            <RowDefinition Height="24*"/>
                        </Grid.RowDefinitions>

                        <!--ATTENDANCE CARD-->
                        <materialDesign:Card Grid.Row="0" HorizontalAlignment="Stretch" Margin="0,10" 
                        VerticalAlignment="Stretch" Background="White" UniformCornerRadius="10" BorderBrush="LightGray" 
                        BorderThickness="1" Effect="{StaticResource CardEffects}">
                            <Grid Margin="20,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30*"/>
                                    <RowDefinition Height="20*"/>
                                    <RowDefinition Height="20*"/>
                                    <RowDefinition Height="30*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Attendance" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="25"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Width="20" Height="20" Kind="CalendarAccount"/>
                                    <TextBlock Text="  Date: " FontFamily="{StaticResource PoppinsMedium}" FontSize="14"/>
                                    <TextBlock x:Name="txtCurrentDate" Text="January 25, 2025" FontFamily="{StaticResource PoppinsRegular}" FontSize="14"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Width="20" Height="20" Kind="ClockAlertOutline"/>
                                    <TextBlock Text="  Time: " FontFamily="{StaticResource PoppinsMedium}" FontSize="14"/>
                                    <TextBlock x:Name="txtCurrentTime" Text="4:35 PM" FontFamily="{StaticResource PoppinsRegular}" FontSize="14"/>
                                </StackPanel>

                                <Viewbox Grid.Row="3">
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="btnTimeIn" Background="LightGreen" BorderBrush="DarkGreen" BorderThickness="2" >
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="DoorOpen" Foreground="DarkGreen"/>
                                                <TextBlock Text="   Time In" Foreground="DarkGreen"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="btnTimeOut" Background="LightPink" BorderBrush="DarkRed" BorderThickness="2" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="DoorClosed" Foreground="DarkRed"/>
                                                <TextBlock Text="  Time Out" Foreground="DarkRed"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Viewbox>

                            </Grid>
                        </materialDesign:Card>

                        <!--Upcoming-->
                        <materialDesign:Card Grid.Row="1" HorizontalAlignment="Stretch" Margin="0,10" 
                                         VerticalAlignment="Stretch" Background="White" UniformCornerRadius="10" BorderBrush="LightGray" 
                                         BorderThickness="1" Effect="{StaticResource CardEffects}" Padding="20,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70*"/>
                                    <ColumnDefinition Width="30*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Upcoming" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="25"/>
                                    <TextBlock x:Name="txtUpcomingPayroll" Text="{Binding Upcoming, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource PoppinsRegular}" FontSize="16"/>
                                </StackPanel>

                                <materialDesign:PackIcon Grid.Column="2" 
                                                     Kind="CalendarClock"
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Right"
                                                     Width="50" Height="50"/>
                            </Grid>

                        </materialDesign:Card>

                        <!--Leave Allowance-->
                        <materialDesign:Card Grid.Row="2" HorizontalAlignment="Stretch" Margin="0,10" 
                                        VerticalAlignment="Stretch" Background="White" UniformCornerRadius="10" BorderBrush="LightGray" 
                                        BorderThickness="1" Effect="{StaticResource CardEffects}" Padding="20,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70*"/>
                                    <ColumnDefinition Width="30*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Target" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="25"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="txtWeeklyHourTarget" Text="{Binding Target, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource PoppinsRegular}" FontSize="16"/>
                                    </StackPanel>
                                </StackPanel>

                                <materialDesign:PackIcon Grid.Column="2" 
                                                    Kind="Target"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"
                                                    Width="50" Height="50"/>
                            </Grid>

                        </materialDesign:Card>

                        <!--Absences-->
                        <materialDesign:Card Grid.Row="3" HorizontalAlignment="Stretch" Margin="0,10" 
                            VerticalAlignment="Stretch" Background="White" UniformCornerRadius="10" BorderBrush="LightGray" 
                            BorderThickness="1" Effect="{StaticResource CardEffects}" Padding="20,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70*"/>
                                    <ColumnDefinition Width="30*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Hourly Rate" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="25"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="txtHourlyRate" Text="{Binding HourlyRate, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource PoppinsRegular}" FontSize="16"/>
                                    </StackPanel>
                                </StackPanel>

                                <materialDesign:PackIcon Grid.Column="2" 
                             Kind="ClockAuto"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Right"
                             Width="50" Height="50"/>
                            </Grid>
                        </materialDesign:Card>

                    </Grid>
                    
                    <!--Graphs-->
                    <materialDesign:Card Grid.Column="1" HorizontalAlignment="Stretch" Margin="5,10,10,10" 
                            VerticalAlignment="Stretch" Background="White" UniformCornerRadius="10" BorderBrush="LightGray" 
                            BorderThickness="1" Effect="{StaticResource CardEffects}" Padding="20,10">
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,5">
                                <TextBlock Grid.Row="0" Text="Hours Rendered" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="25"/>
                                
                                <lvc:Gauge Grid.Row="2" Grid.Column="1"
                                            From="0" To="{Binding TargetHours, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Value="{Binding HoursRendered, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                            LabelsVisibility="Collapsed"
                                            Margin="0,20,0,15"
                                           Width="260" Height="130">
                                    <lvc:Gauge.GaugeActiveFill>
                                        <LinearGradientBrush>
                                            <GradientStop Color="#FF66BB6A" Offset="0.0" />
                                            <!-- Light Green -->
                                            <GradientStop Color="#FF43A047" Offset="0.5" />
                                            <!-- Medium Green -->
                                            <GradientStop Color="#FF1B5E20" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </lvc:Gauge.GaugeActiveFill>
                                </lvc:Gauge>

                                <TextBlock x:Name="txtHoursRemaining" Text="30 hours remaining" FontFamily="{StaticResource PoppinsRegular}" FontSize="16" HorizontalAlignment="Center"/>

                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,5">
                                <TextBlock Grid.Row="0" Text="Daily Performance" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="25"/>

                                <lvc:CartesianChart Series="{Binding SeriesCollection}" LegendLocation="Right" Height="190">
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis Title="Hours" LabelFormatter="{Binding YFormatter}" MinValue="0" MaxValue="24"/>
                                    </lvc:CartesianChart.AxisY>
                                    
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Title="Day" Labels="{Binding Labels}">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator Step="1" />
                                            </lvc:Axis.Separator>
                                            <lvc:Axis.LabelsRotation>45</lvc:Axis.LabelsRotation>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisX>
                                </lvc:CartesianChart>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>

                    <!--Attednance Log-->
                    <Grid Grid.Column="2" Margin="5,0,0,0">
                        <materialDesign:Card Grid.Row="3" HorizontalAlignment="Stretch" Margin="0,10" 
                            VerticalAlignment="Stretch" Background="White" UniformCornerRadius="10" BorderBrush="LightGray" 
                            BorderThickness="1" Effect="{StaticResource CardEffects}" Padding="20,10">

                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="8*"/>
                                    <RowDefinition Height="2*"/>
                                    <RowDefinition Height="90*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Attendance Log" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="25"/>

                                <!--Data Grid-->
                                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <DataGrid x:Name="dataGridDashboardAttendanceLog"
                                            AutoGenerateColumns="False" FontSize="14"
                                            ItemsSource="{Binding AttendanceLogList, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsReadOnly="True"
                                            HorizontalScrollBarVisibility="Disabled">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Date" Width="150" Binding="{Binding Date}"/>
                                            <DataGridTextColumn Header="Time In" Width="150" Binding="{Binding TimeIn}"/>
                                            <DataGridTextColumn Header="Time Out" Width="150" Binding="{Binding TimeOut}"/>
                                            <DataGridTextColumn Header="Duration" Width="150" Binding="{Binding Status}"/>
                                            <!-- Add more columns if needed -->
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ScrollViewer>

                            </Grid>
                        </materialDesign:Card>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
