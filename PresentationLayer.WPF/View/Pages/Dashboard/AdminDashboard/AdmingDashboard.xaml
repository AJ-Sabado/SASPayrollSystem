<UserControl x:Class="PresentationLayer.WPF.View.Pages.Dashboard.AdminDashboard.AdmingDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PresentationLayer.WPF.View.Pages.Dashboard.AdminDashboard"
             
             xmlns:userControls="clr-namespace:PresentationLayer.WPF.View.Pages.Dashboard.EmployeeDashboardReg"
            xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             
             mc:Ignorable="d" 
             d:DesignHeight="688" d:DesignWidth="1088">
    <Viewbox>
        <Grid x:Name="Canvas" Height="688" Width="1088">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid x:Name="Base" Margin="20" Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="7*"/>
                        <RowDefinition Height="15*"/>
                        <RowDefinition Height="78*"/>
                    </Grid.RowDefinitions>

                    <!---TITLE-->
                    <TextBlock Grid.Row="0" Text="DASHBOARD" 
                    FontFamily="{StaticResource PoppinsBold}" 
                    FontSize="30" Foreground="Black" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                    <!--ADMIN DETAILS-->
                    <materialDesign:Card Grid.Row="1" HorizontalAlignment="Stretch" Margin="0,10" 
                    VerticalAlignment="Stretch" Background="White" UniformCornerRadius="10" BorderBrush="LightGray" 
                    BorderThickness="1" Effect="{StaticResource CardEffects}">
                        <Grid Margin="20,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="8*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" >
                                <StackPanel Orientation="Horizontal" >
                                    <TextBlock Text="Welcome Back, " FontFamily="{StaticResource PoppinsSemiBold}" FontSize="25" />
                                    <TextBlock Name="txtEmployeeFirstName" Text="Juan" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="25"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Name="txtEmployeeID" Text="EMP-00123" 
                                   FontFamily="{StaticResource PoppinsLight}" FontSize="14" FontStyle="Italic"/>
                                    <TextBlock Text="   |   " 
                                   FontFamily="{StaticResource PoppinsLight}" FontSize="14" FontStyle="Italic"/>
                                    <TextBlock Name="txtEmployeePosition" Text="Software Engineer" 
                                   FontFamily="{StaticResource PoppinsLight}" FontSize="14" FontStyle="Italic"/>
                                </StackPanel>
                            </StackPanel>

                            <!--SIGN OUT BUTTON-->
                            <Button Grid.Column="1" x:Name="btnLogOut" Style="{StaticResource HeaderButtons}" 
                        Height="30" Width="30" HorizontalAlignment="Right" Click="btnLogOut_Click"
                        Command="{Binding Logout}">
                                <materialDesign:PackIcon Kind="SignOutVariant" Height="20" Width="20"/>
                            </Button>
                        </Grid>
                    </materialDesign:Card>

                    <Grid Grid.Row="2">
                        <!-- Additional content goes here -->
                    </Grid>
                </Grid>
            </ScrollViewer>

        </Grid>
    </Viewbox>
</UserControl>
