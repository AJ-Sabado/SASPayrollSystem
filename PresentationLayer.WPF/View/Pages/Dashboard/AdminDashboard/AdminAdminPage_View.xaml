<UserControl x:Class="PresentationLayer.WPF.View.Pages.Dashboard.AdminDashboard.AdminAdminPage_View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PresentationLayer.WPF.View.Pages.Dashboard.AdminDashboard"
             
              xmlns:userControls="clr-namespace:PresentationLayer.WPF.View.UserControls"
              xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
              xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf" 
             
             mc:Ignorable="d" 
             d:DesignHeight="688" d:DesignWidth="1088">
    
    <Viewbox>
        <Grid x:Name="Canvas" Height="688" Width="1088">
            <Grid x:Name="Base" Margin="0,20,20,20" Background="White">
                <TabControl TabStripPlacement="Left" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TabControl.Resources>
                        <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                            <Setter Property="HeaderTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" 
                                            FontSize="10" 
                                            VerticalAlignment="Center"
                                           Width="100"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                    
                    <!--ROLES AND DEPARTMENTS-->
                    <TabItem Header="Departments &amp; Roles">
                        <Grid Margin="20,0,0,0" Background="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="7*"/>
                                <RowDefinition Height="20*"/>
                                <RowDefinition Height="73*"/>
                            </Grid.RowDefinitions>

                            <!-- TITLE -->
                            <TextBlock Grid.Row="0" Text="DEPARTMENTS AND ROLES" 
                                       FontFamily="{StaticResource PoppinsBold}" 
                                       FontSize="30" Foreground="Black" 
                                       HorizontalAlignment="Left" VerticalAlignment="Top"/>

                            <!--SUMMARIES-->
                            <materialDesign:Card Grid.Row="1" HorizontalAlignment="Stretch" 
                                                 VerticalAlignment="Stretch" Background="White" 
                                                 UniformCornerRadius="10" BorderBrush="LightGray" 
                                                 BorderThickness="1" Effect="{StaticResource CardEffects}"
                                                 Padding="30,15" Margin="0,7.5">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="1*"/>

                                    </Grid.ColumnDefinitions>

                                    <Rectangle Grid.Column="1" Width="0.5" Height="70" Fill="Gray" HorizontalAlignment="Center"/>
                                    <Rectangle Grid.Column="3" Width="0.5" Height="70" Fill="Gray" HorizontalAlignment="Center"/>

                                    <!-- Total Employees -->
                                    <Grid Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding EmployeeCount}"
                                                   FontFamily="{StaticResource PoppinsSemiBold}" 
                                                   FontSize="35"
                                                   Foreground="Black"
                                                   HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="1"
                                                   Text="Total Number of Employees"
                                                   FontFamily="{StaticResource PoppinsLight}" 
                                                   FontSize="12"
                                                   Foreground="Black"
                                                   HorizontalAlignment="Left"/>
                                    </Grid>

                                    <!-- Total DEPARTMENRS -->
                                    <Grid Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                    Text="{Binding DepartmentsCount}"
                                                    FontFamily="{StaticResource PoppinsSemiBold}" 
                                                    FontSize="35"
                                                    Foreground="Black"
                                                    HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="1"
                                                    Text="Total Number of Departments"
                                                    FontFamily="{StaticResource PoppinsLight}" 
                                                    FontSize="12"
                                                    Foreground="Black"
                                                    HorizontalAlignment="Left"/>
                                    </Grid>

                                    <!-- Total ROLES -->
                                    <Grid Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                    Text="{Binding RolesCount}"
                                                    FontFamily="{StaticResource PoppinsSemiBold}" 
                                                    FontSize="35"
                                                    Foreground="Black"
                                                    HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="1"
                                                    Text="Total Number of Roles"
                                                    FontFamily="{StaticResource PoppinsLight}" 
                                                    FontSize="12"
                                                    Foreground="Black"
                                                    HorizontalAlignment="Left"/>
                                    </Grid>

                                </Grid>
                            </materialDesign:Card>


                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!--DEPARTMENTS-->
                                <materialDesign:Card Grid.Column="0" HorizontalAlignment="Stretch" 
                                                     VerticalAlignment="Stretch" Background="White" 
                                                     UniformCornerRadius="10" BorderBrush="LightGray" 
                                                     BorderThickness="1" Effect="{StaticResource CardEffects}"
                                                     Padding="20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Departments" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="22"/>

                                            <Button Grid.Column="1" Background="LightGoldenrodYellow" 
                                                    Foreground="DarkGoldenrod" BorderBrush="DarkGoldenrod"
                                                    Command="{Binding AddDepartment}"
                                                    >
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="AddCircleOutline"/>
                                                    <TextBlock Text="  Add Department" 
                                                        FontFamily="{StaticResource PoppinsLight}" 
                                                        FontSize="12" Margin="5,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <DataGrid Grid.Row="2"
                                                  AutoGenerateColumns="False"
                                                  HeadersVisibility="Column"
                                                  CanUserAddRows="False"
                                                  Margin="0,10,0,0"
                                                  ItemsSource="{Binding DepartmentsTable}"
                                                  materialDesign:DataGridAssist.CellPadding="5"
                                                  materialDesign:DataGridAssist.ColumnHeaderPadding="5,5"
                                                  RowHeight="40"
                                                  FontSize="12"
                                                  IsReadOnly="True"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto"
                                                  Background="Transparent"
                                                  VerticalContentAlignment="Center">

                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Department Name"
                                                                    Binding="{Binding Name}"
                                                                    Width="2*"
                                                                    MinWidth="150"
                                                                    ElementStyle="{StaticResource TextBlockWrapStyle}" />

                                                <DataGridTextColumn Header="Normalized Name"
                                                                    Binding="{Binding NormalizedName}"
                                                                    Width="2*"
                                                                    MinWidth="150"
                                                                    ElementStyle="{StaticResource TextBlockWrapStyle}" />

                                                <DataGridTemplateColumn Header="Actions"
                                                                        Width="100">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding DataContext.DeleteDepartment, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource MaterialDesignToolButton}"
                                                                    ToolTip="Delete Department"
                                                                    HorizontalAlignment="Center"
                                                                    Margin="2,0">
                                                                <materialDesign:PackIcon Kind="Delete"
                                                                                    Width="18"
                                                                                    Height="18"
                                                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                                            </Button>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </materialDesign:Card>

                                <!--ROLES-->
                                <materialDesign:Card Grid.Column="2" HorizontalAlignment="Stretch" 
                                                        VerticalAlignment="Stretch" Background="White" 
                                                        UniformCornerRadius="10" BorderBrush="LightGray" 
                                                        BorderThickness="1" Effect="{StaticResource CardEffects}"
                                                        Padding="20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Roles" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="22"/>

                                            
                                        </Grid>

                                        <DataGrid Grid.Row="2"
                                                  AutoGenerateColumns="False"
                                                  HeadersVisibility="Column"
                                                  CanUserAddRows="False"
                                                  Margin="0,10,0,0"
                                                  ItemsSource="{Binding RolesTable}"
                                                  materialDesign:DataGridAssist.CellPadding="5"
                                                  materialDesign:DataGridAssist.ColumnHeaderPadding="5,5"
                                                  RowHeight="40"
                                                  FontSize="12"
                                                  IsReadOnly="True"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto"
                                                  Background="Transparent"
                                                  VerticalContentAlignment="Center">

                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Role Name"
                                                                    Binding="{Binding Name}"
                                                                    Width="2*"
                                                                    MinWidth="150"
                                                                    ElementStyle="{StaticResource TextBlockWrapStyle}" />

                                                <DataGridTextColumn Header="Normalized Name"
                                                                    Binding="{Binding NormalizedName}"
                                                                    Width="2*"
                                                                    MinWidth="150"
                                                                    ElementStyle="{StaticResource TextBlockWrapStyle}" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                    </Grid>
                                </materialDesign:Card>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- COMPANY HOLIDAYS -->
                    <TabItem Header="Company Holidays">
                        <Grid Margin="20,0,0,0" Background="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- TITLE AND ADD BUTTON -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="COMPANY HOLIDAYS" 
                                           FontFamily="{StaticResource PoppinsBold}" 
                                           FontSize="30" Foreground="Black" 
                                           VerticalAlignment="Center" Margin="0,0,450,0"/>
                                <Button Command="{Binding AddHoliday}"
                                            Margin="20,0,0,0"
                                            Padding="10,5"
                                            VerticalAlignment="Center"
                                            Foreground="DarkGoldenrod"
                                            Background="LightGoldenrodYellow"
                                            BorderBrush="DarkGoldenrod">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AddCircleOutline"/>
                                        <TextBlock Text="  Add Holiday" 
                                                    FontFamily="{StaticResource PoppinsSemiBold}" 
                                                    FontSize="12" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- HOLIDAYS DATAGRID -->
                            <materialDesign:Card Grid.Row="1"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Stretch"
                                                 Background="White"
                                                 UniformCornerRadius="10"
                                                 BorderBrush="LightGray"
                                                 BorderThickness="1"
                                                 Effect="{StaticResource CardEffects}"
                                                 Padding="20,15"
                                                 Margin="0,10,0,0">

                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              CanContentScroll="False">
                                    <DataGrid AutoGenerateColumns="False"
                                              HeadersVisibility="Column"
                                              CanUserAddRows="False"
                                              Margin="0"
                                              ItemsSource="{Binding HolidaysTable}"
                                              materialDesign:DataGridAssist.CellPadding="10"
                                              materialDesign:DataGridAssist.ColumnHeaderPadding="10,5"
                                              RowHeight="50"
                                              FontSize="12"
                                              IsReadOnly="True"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              Background="Transparent">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Holiday Name"
                                                Binding="{Binding Description}"
                                                Width="2*"
                                                MinWidth="250"
                                                ElementStyle="{StaticResource TextBlockWrapStyle}" />

                                            <DataGridTextColumn Header="Date"
                                                                Binding="{Binding Date, StringFormat=d}"
                                                                Width="1.5*"
                                                                MinWidth="250"
                                                                ElementStyle="{StaticResource TextBlockWrapStyle}" />

                                            <DataGridTextColumn Header="Type"
                                                                Binding="{Binding Type}"
                                                                Width="1*"
                                                                MinWidth="250"
                                                                ElementStyle="{StaticResource TextBlockWrapStyle}" />

                                            <DataGridTemplateColumn Header="Actions"
                                                                    Width="1*"
                                                                MinWidth="50">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.DeleteHoliday, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource MaterialDesignToolButton}"
                                                                ToolTip="Delete Holiday"
                                                                HorizontalAlignment="Center"
                                                                Margin="2,0">
                                                            <materialDesign:PackIcon Kind="Delete"
                                                         Width="18"
                                                         Height="18"
                                                         Foreground="Red"/>
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ScrollViewer>
                            </materialDesign:Card>

                        </Grid>
                    </TabItem>



                </TabControl>

            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
