<UserControl x:Class="PresentationLayer.WPF.View.Pages.Dashboard.AdminDashboard.AdminAdminPage_View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PresentationLayer.WPF.View.Pages.Dashboard.AdminDashboard"
             
              xmlns:userControls="clr-namespace:PresentationLayer.WPF.View.UserControls"
              xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
              xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf" 
             
             mc:Ignorable="d" 
             d:DesignHeight="688" d:DesignWidth="1088">
    
    <Viewbox>
        <Grid x:Name="Canvas" Height="688" Width="1088">
            <Grid x:Name="Base" Margin="0,20,20,20" Background="White">
                <TabControl TabStripPlacement="Left" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TabControl.Resources>
                        <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                            <Setter Property="HeaderTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" 
                                            FontSize="10" 
                                            VerticalAlignment="Center"
                                           Width="100"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                    
                    <!--ROLES AND DEPARTMENTS-->
                    <TabItem Header="Departments &amp; Roles">
                        <Grid Margin="20,0,0,0" Background="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="7*"/>
                                <RowDefinition Height="20*"/>
                                <RowDefinition Height="73*"/>
                            </Grid.RowDefinitions>

                            <!-- TITLE -->
                            <TextBlock Grid.Row="0" Text="DEPARTMENTS AND ROLES" 
                                       FontFamily="{StaticResource PoppinsBold}" 
                                       FontSize="30" Foreground="Black" 
                                       HorizontalAlignment="Left" VerticalAlignment="Top"/>

                            <!--SUMMARIES-->
                            <materialDesign:Card Grid.Row="1" HorizontalAlignment="Stretch" 
                                                 VerticalAlignment="Stretch" Background="White" 
                                                 UniformCornerRadius="10" BorderBrush="LightGray" 
                                                 BorderThickness="1" Effect="{StaticResource CardEffects}"
                                                 Padding="30,15" Margin="0,7.5">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="1*"/>

                                    </Grid.ColumnDefinitions>

                                    <Rectangle Grid.Column="1" Width="0.5" Height="70" Fill="Gray" HorizontalAlignment="Center"/>
                                    <Rectangle Grid.Column="3" Width="0.5" Height="70" Fill="Gray" HorizontalAlignment="Center"/>

                                    <!-- Total Employees -->
                                    <Grid Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="250"
                                                   FontFamily="{StaticResource PoppinsSemiBold}" 
                                                   FontSize="35"
                                                   Foreground="Black"
                                                   HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="1"
                                                   Text="Total Number of Employees"
                                                   FontFamily="{StaticResource PoppinsLight}" 
                                                   FontSize="12"
                                                   Foreground="Black"
                                                   HorizontalAlignment="Left"/>
                                    </Grid>

                                    <!-- Total DEPARTMENRS -->
                                    <Grid Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                    Text="10"
                                                    FontFamily="{StaticResource PoppinsSemiBold}" 
                                                    FontSize="35"
                                                    Foreground="Black"
                                                    HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="1"
                                                    Text="Total Number of Departments"
                                                    FontFamily="{StaticResource PoppinsLight}" 
                                                    FontSize="12"
                                                    Foreground="Black"
                                                    HorizontalAlignment="Left"/>
                                    </Grid>

                                    <!-- Total ROLES -->
                                    <Grid Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                    Text="50"
                                                    FontFamily="{StaticResource PoppinsSemiBold}" 
                                                    FontSize="35"
                                                    Foreground="Black"
                                                    HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="1"
                                                    Text="Total Number of Roles"
                                                    FontFamily="{StaticResource PoppinsLight}" 
                                                    FontSize="12"
                                                    Foreground="Black"
                                                    HorizontalAlignment="Left"/>
                                    </Grid>

                                </Grid>
                            </materialDesign:Card>


                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!--DEPARTMENTS-->
                                <materialDesign:Card Grid.Column="0" HorizontalAlignment="Stretch" 
                                                     VerticalAlignment="Stretch" Background="White" 
                                                     UniformCornerRadius="10" BorderBrush="LightGray" 
                                                     BorderThickness="1" Effect="{StaticResource CardEffects}"
                                                     Padding="20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Departments" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="22"/>

                                            <Button Grid.Column="1" Background="LightGoldenrodYellow" 
                                                    Foreground="DarkGoldenrod" BorderBrush="DarkGoldenrod">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="AddCircleOutline"/>
                                                    <TextBlock Text="  Add Department" 
                                                        FontFamily="{StaticResource PoppinsLight}" 
                                                        FontSize="12" Margin="5,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <DataGrid Grid.Row="2"
                                                  AutoGenerateColumns="False" 
                                                  HeadersVisibility="Column" 
                                                  CanUserAddRows="False" 
                                                  Margin="0,10,0,0" 
                                                  ItemsSource="{Binding Departments}" 
                                                  SelectedItem="{Binding SelectedDepartment}" 
                                                  materialDesign:DataGridAssist.CellPadding="10" 
                                                  materialDesign:DataGridAssist.ColumnHeaderPadding="10,5" 
                                                  RowHeight="40" 
                                                  FontSize="12" 
                                                  IsReadOnly="True" 
                                                  HorizontalScrollBarVisibility="Auto" 
                                                  VerticalScrollBarVisibility="Auto"
                                                  Background="Transparent">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="ID" Binding="{Binding DepartmentID}" Width="1*" />
                                                <DataGridTextColumn Header="Department Name" Binding="{Binding Name}" Width="3*" />
                                                <DataGridTextColumn Header="Code" Binding="{Binding DepartmentCode}" Width="2*" />
                                                <DataGridTemplateColumn Header="Actions" Width="1.5*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{materialDesign:PackIcon Kind=Delete}"  
                                                                    Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding}" 
                                                                    Style="{StaticResource MaterialDesignFlatButton}" 
                                                                    Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>

                                        </DataGrid>
                                    </Grid>
                                </materialDesign:Card>

                                <!--ROLES-->
                                <materialDesign:Card Grid.Column="2" HorizontalAlignment="Stretch" 
                                                        VerticalAlignment="Stretch" Background="White" 
                                                        UniformCornerRadius="10" BorderBrush="LightGray" 
                                                        BorderThickness="1" Effect="{StaticResource CardEffects}"
                                                        Padding="20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Roles" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="22"/>

                                            
                                        </Grid>

                                        <DataGrid Grid.Row="2"
                                                  AutoGenerateColumns="False" 
                                                  HeadersVisibility="Column" 
                                                  CanUserAddRows="False" 
                                                  Margin="0,10,0,0" 
                                                  ItemsSource="{Binding Departments}" 
                                                  SelectedItem="{Binding SelectedDepartment}" 
                                                  materialDesign:DataGridAssist.CellPadding="10" 
                                                  materialDesign:DataGridAssist.ColumnHeaderPadding="10,5" 
                                                  RowHeight="40" 
                                                  FontSize="12" 
                                                  IsReadOnly="True" 
                                                  HorizontalScrollBarVisibility="Auto" 
                                                  VerticalScrollBarVisibility="Auto"
                                                  Background="Transparent">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="ID" Binding="{Binding DepartmentID}" Width="1*" />
                                                <DataGridTextColumn Header="Role Name" Binding="{Binding Name}" Width="3*" />
                                                <DataGridTextColumn Header="Parent Department" Binding="{Binding DepartmentCode}" Width="2.5*" />
                                                <DataGridTemplateColumn Header="Actions" Width="1.5*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{materialDesign:PackIcon Kind=Delete}" 
                                                                    Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding}" 
                                                                    Style="{StaticResource MaterialDesignFlatButton}" 
                                                                    Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>

                                        </DataGrid>
                                    </Grid>
                                </materialDesign:Card>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- COMPANY HOLIDAYS -->
                    <TabItem Header="Company Holidays">
                        <Grid Margin="20,0,0,0" Background="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- TITLE AND ADD BUTTON -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="COMPANY HOLIDAYS" 
                                           FontFamily="{StaticResource PoppinsBold}" 
                                           FontSize="30" Foreground="Black" 
                                           VerticalAlignment="Center" Margin="0,0,450,0"/>
                                <Button Command="{Binding AddHolidayCommand}"
                                            Margin="20,0,0,0"
                                            Padding="10,5"
                                            VerticalAlignment="Center"
                                            Foreground="DarkGoldenrod"
                                            Background="LightGoldenrodYellow"
                                            BorderBrush="DarkGoldenrod">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AddCircleOutline"/>
                                        <TextBlock Text="  Add Holiday" 
                                                    FontFamily="{StaticResource PoppinsSemiBold}" 
                                                    FontSize="12" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- HOLIDAYS DATAGRID -->
                            <materialDesign:Card Grid.Row="1" HorizontalAlignment="Stretch" 
                                                 VerticalAlignment="Stretch" Background="White" 
                                                 UniformCornerRadius="10" BorderBrush="LightGray" 
                                                 BorderThickness="1" Effect="{StaticResource CardEffects}"
                                                 Padding="20,15">

                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              CanContentScroll="False">
                                    <DataGrid AutoGenerateColumns="False"
                                              HeadersVisibility="Column"
                                              CanUserAddRows="False"
                                              Margin="0"
                                              ItemsSource="{Binding Holidays}"
                                              SelectedItem="{Binding SelectedHoliday}"
                                              materialDesign:DataGridAssist.CellPadding="10"
                                              materialDesign:DataGridAssist.ColumnHeaderPadding="10"
                                              RowHeight="40"
                                              FontSize="12"
                                              Background="Transparent">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Holiday Name" Binding="{Binding Name}" Width="200*"/>
                                            <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="100*"/>
                                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="250*"/>
                                            <DataGridTemplateColumn Header="Actions" Width="100*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Delete"
                                                                Command="{Binding DataContext.DeleteHolidayCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                                Foreground="Red"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ScrollViewer>

                            </materialDesign:Card>
                        </Grid>
                    </TabItem>



                </TabControl>

            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
