<UserControl x:Class="PresentationLayer.WPF.View.Pages.Dashboard.AdminDashboard.AdminDashPage_View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PresentationLayer.WPF.View.Pages.Dashboard.AdminDashboard"
             
             xmlns:userControls="clr-namespace:PresentationLayer.WPF.View.Pages.Dashboard.EmployeeDashboardReg"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="688" d:DesignWidth="1088">
    
    <Viewbox>
    <Grid x:Name="Canvas" Height="688" Width="1088">
        <Grid x:Name="Base" Margin="20" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="7*"/>
                <RowDefinition Height="15*"/>
                <RowDefinition Height="78*"/>
            </Grid.RowDefinitions>

            <!-- TITLE -->
            <TextBlock Grid.Row="0" Text="DASHBOARD" 
                       FontFamily="{StaticResource PoppinsBold}" 
                       FontSize="30" Foreground="Black" 
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>

            <!-- ADMIN DETAILS -->
            <materialDesign:Card Grid.Row="1" HorizontalAlignment="Stretch" Margin="0,10" 
                                 VerticalAlignment="Stretch" Background="White" 
                                 UniformCornerRadius="10" BorderBrush="LightGray" 
                                 BorderThickness="1" Effect="{StaticResource CardEffects}">
                <Grid Margin="20,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Welcome Back, " FontFamily="{StaticResource PoppinsSemiBold}" FontSize="25" />
                            <TextBlock Name="txtEmployeeFirstName" Text="{Binding FirstName}" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="25"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Name="txtEmployeeID" Text="{Binding CompanyId}" 
                                       FontFamily="{StaticResource PoppinsLight}" FontSize="14" FontStyle="Italic"/>
                            <TextBlock Text="   |   " 
                                       FontFamily="{StaticResource PoppinsLight}" FontSize="14" FontStyle="Italic"/>
                            <TextBlock Name="txtEmployeePosition" Text="{Binding Role}" 
                                       FontFamily="{StaticResource PoppinsLight}" FontSize="14" FontStyle="Italic"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- SIGN OUT BUTTON -->
                    <Button Grid.Column="1" x:Name="btnLogOut" Style="{StaticResource HeaderButtons}" 
                            Height="30" Width="30" HorizontalAlignment="Right"
                            Command="{Binding Logout}">
                        <materialDesign:PackIcon Kind="SignOutVariant" Height="20" Width="20"/>
                    </Button>
                </Grid>
            </materialDesign:Card>

            <!--DATA VIEW -->
            <Grid Grid.Row="2" Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!--GRAPHS AND TABLE-->
                <Grid Grid.Column="0" Margin="0,0,7.5,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <materialDesign:Card Grid.Row="0" HorizontalAlignment="Stretch" 
                         VerticalAlignment="Stretch" Background="White" 
                         UniformCornerRadius="10" BorderBrush="LightGray" 
                         BorderThickness="1" Effect="{StaticResource CardEffects}"
                         Padding="20">

                            <lvc:CartesianChart Series="{Binding PayrollSeries}" Margin="0,0,-4,-5">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Title="Payroll Date" Labels="{Binding Labels}" LabelsRotation="45"/>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="Amount" LabelFormatter="{Binding Formatter}" />
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>

                        </materialDesign:Card>

                    <!--EMPLOYEE LOGIN-->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <materialDesign:Card Grid.Column="0" HorizontalAlignment="Stretch" 
                                                 VerticalAlignment="Stretch" Background="White" 
                                                 UniformCornerRadius="10" BorderBrush="LightGray" 
                                                 BorderThickness="1" Effect="{StaticResource CardEffects}"
                                                 Padding="20">

                                <StackPanel>
                                    <TextBlock Grid.Row="0" Text="Regular Employee Recent Logs" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="18" Margin="0,0,0,10"/>

                                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <DataGrid x:Name="dgRegTimeLog"
                                                  AutoGenerateColumns="False"
                                                  FontSize="10"
                                                  ItemsSource="{Binding EmployeeAttendanceLogs, Mode=OneWay}"
                                                  ColumnWidth="Auto"
                                                  IsReadOnly="True"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Width="515" Height="150">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="ID" Width="Auto" Binding="{Binding BusinessId}" />
                                                <DataGridTextColumn Header="Employee" Width="Auto" Binding="{Binding Employee.User.AccountInfo.LastName}" />
                                                <DataGridTextColumn Header="Date" Width="Auto" Binding="{Binding Date}" />
                                                <DataGridTextColumn Header="Time" Width="Auto" Binding="{Binding TimeStamp, StringFormat='{}{0:hh:mm:ss tt}'}" />
                                                <DataGridTextColumn Header="Log Type" Width="Auto" Binding="{Binding EventType}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ScrollViewer>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Grid.Column="2" HorizontalAlignment="Stretch" 
                                                 VerticalAlignment="Stretch" Background="White" 
                                                 UniformCornerRadius="10" BorderBrush="LightGray" 
                                                 BorderThickness="1" Effect="{StaticResource CardEffects}"
                                                 Padding="20">

                                <StackPanel>
                                    <TextBlock Grid.Row="0" Text="Contractor Recent Logs" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="18" Margin="0,0,0,10"/>

                                    <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <DataGrid x:Name="dgICAteendanceLog"
                                                  AutoGenerateColumns="False"
                                                  FontSize="10"
                                                  ItemsSource="{Binding ContractorAttendanceLogModels, Mode=OneWay}"
                                                  ColumnWidth="Auto"
                                                  IsReadOnly="True"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Width="512" Height="150">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="ID" Width="Auto" Binding="{Binding BusinessId}" />
                                                <DataGridTextColumn Header="Employee" Width="Auto" Binding="{Binding Contractor.User.AccountInfo.LastName}" />
                                                <DataGridTextColumn Header="Date" Width="Auto" Binding="{Binding Date}" />
                                                <DataGridTextColumn Header="Time In" Width="Auto" Binding="{Binding TimeIn, StringFormat='{}{0:hh:mm tt}'}" />
                                                <DataGridTextColumn Header="Time Out" Width="Auto" Binding="{Binding TimeOut, StringFormat='{}{0:hh:mm tt}'}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ScrollViewer>
                                </StackPanel>
                            </materialDesign:Card>

                        </Grid>

                </Grid>

                <!--SUMMARIES -->
                <Grid Grid.Column="1" Margin="7.5,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <materialDesign:Card Grid.Row="0" HorizontalAlignment="Stretch" 
                         VerticalAlignment="Stretch" Background="White" 
                         UniformCornerRadius="10" BorderBrush="LightGray" 
                         BorderThickness="1" Effect="{StaticResource CardEffects}"
                         Padding="20">

                        <StackPanel>
                            <TextBlock Grid.Row="0" Text="Number of Employees" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="20"/>
                            <TextBlock x:Name="txtNumberofEmployees" Text="January 15, 2025" FontFamily="{StaticResource PoppinsRegular}" FontSize="16"/>

                                <lvc:PieChart Name="Chart"
                                      Series="{Binding SeriesCollection}"
                                      LegendLocation="Right"
                                      InnerRadius="30"
                                      Margin="0,10,0,0"
                                      Height="140">         
                                    <lvc:PieChart.ChartLegend>
                                        <lvc:DefaultLegend BulletSize="20" />
                                    </lvc:PieChart.ChartLegend>
                                    <lvc:PieChart.DataTooltip>
                                        <lvc:DefaultTooltip BulletSize="20" />
                                    </lvc:PieChart.DataTooltip>
                                </lvc:PieChart>

                            </StackPanel>
                    </materialDesign:Card>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <materialDesign:Card Grid.Row="0" HorizontalAlignment="Stretch" 
                             VerticalAlignment="Stretch" Background="White" 
                             UniformCornerRadius="10" BorderBrush="LightGray" 
                             BorderThickness="1" Effect="{StaticResource CardEffects}"
                             Padding="20,15">

                                <StackPanel>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" >
                                        <materialDesign:PackIcon Kind="Payment" Width="18" Height="18"/>
                                        <TextBlock Text="  Previous Payroll" 
                                            FontFamily="{StaticResource PoppinsMedium}" FontSize="14"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding PreviousAmount}" 
                                            FontFamily="{StaticResource PoppinsBold}" FontSize="25"
                                               Margin="0,3" Foreground="DarkGoldenrod"/>

                                    <TextBlock Text="{Binding PreviousDate}" 
                                            FontFamily="{StaticResource PoppinsRegular}" FontSize="10"
                                               Margin="0,0,0,0"/>
                                </StackPanel>
                            </materialDesign:Card>

                        <materialDesign:Card Grid.Row="2" HorizontalAlignment="Stretch" 
                                 VerticalAlignment="Stretch" Background="White" 
                                 UniformCornerRadius="10" BorderBrush="LightGray" 
                                 BorderThickness="1" Effect="{StaticResource CardEffects}"
                                 Padding="20,15">

                                <StackPanel>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" >
                                        <materialDesign:PackIcon Kind="PaymentOnDelivery" Width="18" Height="18"/>
                                        <TextBlock Text="  Current Payroll" 
                                                    FontFamily="{StaticResource PoppinsMedium}" FontSize="14"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CurrentAmount}" 
                                                FontFamily="{StaticResource PoppinsBold}" FontSize="25"
                                                   Margin="0,3" Foreground="DarkGreen"/>

                                    <TextBlock Text="{Binding CurrentDate}" 
                                            FontFamily="{StaticResource PoppinsRegular}" FontSize="10"
                                               Margin="0,0,0,0"/>
                                </StackPanel>
                            </materialDesign:Card>
                    </Grid>

                </Grid>
            </Grid>


        </Grid>
    </Grid>
    </Viewbox>
</UserControl>
