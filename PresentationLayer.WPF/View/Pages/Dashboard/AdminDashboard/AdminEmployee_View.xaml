<UserControl x:Class="PresentationLayer.WPF.View.Pages.Dashboard.AdminDashboard.AdminEmployee_View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PresentationLayer.WPF.View.Pages.Dashboard.AdminDashboard"
             xmlns:userControls="clr-namespace:PresentationLayer.WPF.View.UserControls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf" 
             mc:Ignorable="d" 
             d:DesignHeight="688" d:DesignWidth="1088">

    <Viewbox>
        <Grid x:Name="Canvas" Height="688" Width="1088">
            <Grid x:Name="Base" Margin="0,20,20,20" Background="White">
                <TabControl TabStripPlacement="Left" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TabControl.Resources>
                        <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                            <Setter Property="HeaderTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="10" VerticalAlignment="Center" Width="100" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- ALL EMPLOYEES TAB -->
                    <TabItem Header="All Employee">
                        <Grid Margin="20,0,0,0" Background="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="7*"/>
                                <RowDefinition Height="20*"/>
                                <RowDefinition Height="73*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="EMPLOYEE" FontFamily="{StaticResource PoppinsBold}" FontSize="30" Foreground="Black" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                            <materialDesign:Card Grid.Row="1" Background="White" UniformCornerRadius="10" BorderBrush="LightGray" BorderThickness="1" Effect="{StaticResource CardEffects}" Padding="20,15" Margin="0,7.5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width=".7*"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="1.1*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- SEARCH -->
                                    <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Quick Search" FontFamily="{StaticResource PoppinsMedium}" FontSize="15" Foreground="Black" HorizontalAlignment="Left"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                                            <TextBox x:Name="tbSearchNameID" materialDesign:HintAssist.Hint="Search Employee Name or ID" Style="{StaticResource MaterialDesignOutlinedTextBox}" BorderThickness="0" VerticalAlignment="Center" Margin="0,5" Width="180" Height="30" Padding="5" FontFamily="{StaticResource PoppinsLight}" FontSize="10"/>
                                            <Button x:Name="SearchBtn" Background="Transparent" Foreground="{StaticResource BaseColorSCB}" BorderBrush="Transparent" Style="{StaticResource MaterialDesignIconButton}" Height="35" Width="35" Margin="5,0,0,0">
                                                <materialDesign:PackIcon Kind="Search"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Separators -->
                                    <Rectangle Grid.Column="1" Width="0.5" Height="70" Fill="Gray" HorizontalAlignment="Center"/>
                                    <Rectangle Grid.Column="3" Width="0.5" Height="70" Fill="Gray" HorizontalAlignment="Center"/>
                                    <Rectangle Grid.Column="5" Width="0.5" Height="70" Fill="Gray" HorizontalAlignment="Center"/>

                                    <!-- Employee Count -->
                                    <Grid Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="250" FontFamily="{StaticResource PoppinsSemiBold}" FontSize="25" Foreground="Black" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="1" Text="Total Number of Employees" FontFamily="{StaticResource PoppinsLight}" FontSize="9" Foreground="Black" HorizontalAlignment="Left"/>
                                    </Grid>

                                    <!-- Filters -->
                                    <Grid Grid.Column="4" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Filters" FontFamily="{StaticResource PoppinsMedium}" FontSize="15" Foreground="Black" HorizontalAlignment="Left"/>
                                        <Grid Grid.Row="1" Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="cbStatusFilter" Grid.Column="0" FontFamily="{StaticResource PoppinsRegular}" FontSize="13" SelectedIndex="0" materialDesign:HintAssist.Hint="Status">
                                                <ComboBoxItem Content=""/>
                                                <ComboBoxItem Content="Regular"/>
                                                <ComboBoxItem Content="Independent Contractor"/>
                                            </ComboBox>
                                            <ComboBox x:Name="cbDepartmentFilter" Grid.Column="2" FontFamily="{StaticResource PoppinsRegular}" FontSize="13" SelectedIndex="0" materialDesign:HintAssist.Hint="Department">
                                                <ComboBoxItem Content=""/>
                                                <ComboBoxItem Content="HR"/>
                                                <ComboBoxItem Content="IT"/>
                                                <ComboBoxItem Content="Finance"/>
                                            </ComboBox>
                                        </Grid>
                                    </Grid>

                                    <!-- Actions (Add Only) -->
                                    <Grid Grid.Column="6" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Actions" FontFamily="{StaticResource PoppinsMedium}" FontSize="15" Foreground="Black" HorizontalAlignment="Left"/>
                                        <Button x:Name="btnAddEmployee" Grid.Row="1" Background="LightGoldenrodYellow" Foreground="DarkGoldenrod" Height="30" Margin="0,10,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="AddCircleOutline" Height="18" Width="18"/>
                                                <TextBlock Text="  Add Employee" FontFamily="{StaticResource PoppinsRegular}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </materialDesign:Card>

                            <!-- DATA GRID -->
                            <materialDesign:Card Grid.Row="2" Background="White" UniformCornerRadius="10" BorderBrush="LightGray" BorderThickness="1" Effect="{StaticResource CardEffects}" Padding="20,15" Margin="0,7.5">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <DataGrid AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" Margin="0" ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" materialDesign:DataGridAssist.CellPadding="10" materialDesign:DataGridAssist.ColumnHeaderPadding="10,5" RowHeight="40" FontSize="12" IsReadOnly="True" Background="Transparent">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="0.7*"/>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                                            <DataGridTextColumn Header="Role" Binding="{Binding Position}" Width="1.5*"/>
                                            <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="2*"/>
                                            <DataGridTextColumn Header="Status" Binding="{Binding Name}" Width="1.3*"/>
                                            <DataGridTemplateColumn Header="Actions" Width="1.5*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Button Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolButton}">
                                                                <materialDesign:PackIcon Kind="Eye" Width="18" Height="18"/>
                                                            </Button>
                                                            <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolButton}">
                                                                <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ScrollViewer>
                            </materialDesign:Card>
                        </Grid>
                    </TabItem>

                    <!-- REQUEST TAB -->
                    <TabItem Header="Requests">
                        <Grid Margin="20,0,0,0" Background="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="7*"/>
                                <RowDefinition Height="93*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="ONBOARDING REQUESTS" FontFamily="{StaticResource PoppinsBold}" FontSize="30" Foreground="Black" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                            <materialDesign:Card Grid.Row="1" Background="White" UniformCornerRadius="10" BorderBrush="LightGray" BorderThickness="1" Effect="{StaticResource CardEffects}" Padding="20,15" Margin="0,7.5">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <DataGrid AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" materialDesign:DataGridAssist.CellPadding="10" materialDesign:DataGridAssist.ColumnHeaderPadding="10,5" RowHeight="40" FontSize="12" IsReadOnly="True" Background="Transparent">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Request ID" Binding="{Binding Id}" Width="1*"/>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                                            <DataGridTextColumn Header="Application Date" Binding="{Binding Position}" Width="1.5*"/>
                                            <DataGridTemplateColumn Header="Actions" Width="1.5*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Button Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolButton}">
                                                                <materialDesign:PackIcon Kind="Eye" Width="18" Height="18"/>
                                                            </Button>
                                                            <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolButton}">
                                                                <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ScrollViewer>
                            </materialDesign:Card>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
