<UserControl x:Class="PresentationLayer.WPF.View.Pages.Dashboard.AdminDashboard.AdminWorkforce_View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PresentationLayer.WPF.View.Pages.Dashboard.AdminDashboard"
             
             
             xmlns:userControls="clr-namespace:PresentationLayer.WPF.View.UserControls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"

             mc:Ignorable="d" 
             d:DesignHeight="688" d:DesignWidth="1088">
    <Viewbox>
        <Grid x:Name="Canvas" Height="688" Width="1088">
            <Grid x:Name="Base" Margin="0,20,20,20" Background="White">

                <TabControl TabStripPlacement="Left" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TabControl.Resources>
                        <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                            <Setter Property="HeaderTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" 
                                                FontSize="10" 
                                                VerticalAlignment="Center"
                                               Width="100"
                                                TextWrapping="Wrap" />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!--EMPLOYEE ATTENDANCE-->
                    <TabItem Header="Employee Attendance">
                        <Grid Margin="20,0,0,0" Background="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="7*"/>
                                <RowDefinition Height="20*"/>
                                <RowDefinition Height="73*"/>
                            </Grid.RowDefinitions>

                            <!-- TITLE -->
                            <TextBlock Grid.Row="0" Text="EMPLOYEE ATTENDANCE" 
                                   FontFamily="{StaticResource PoppinsBold}" 
                                   FontSize="30" Foreground="Black" 
                                   HorizontalAlignment="Left" VerticalAlignment="Top"/>

                            <!--SUMMARIES-->
                            <materialDesign:Card Grid.Row="1" HorizontalAlignment="Stretch" 
                                             VerticalAlignment="Stretch" Background="White" 
                                             UniformCornerRadius="10" BorderBrush="LightGray" 
                                             BorderThickness="1" Effect="{StaticResource CardEffects}"
                                             Padding="20,15" Margin="0,7.5">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width=".7*"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="1.1*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- SEARCH BAR -->
                                    <Grid Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                               Text="Quick Search"
                                               FontFamily="{StaticResource PoppinsMedium}" 
                                               FontSize="15"
                                               Foreground="Black"
                                               HorizontalAlignment="Left"/>

                                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                                            <TextBox Grid.Row="1"
                                                 x:Name="tbSearchNameID"
                                                 materialDesign:HintAssist.Hint="Search Employee Name or ID"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 BorderThickness="0"
                                                 VerticalAlignment="Center" Margin="0,5" Width="310" Height="45"
                                                 Padding="10"
                                                 FontFamily="{StaticResource PoppinsLight}" FontSize="12"/>
                                            <Button x:Name="SearchBtn" Background="Transparent" Foreground="{StaticResource BaseColorSCB}"
                                                BorderBrush="Transparent" Style="{StaticResource MaterialDesignIconButton}"
                                                Height="45" Width="45" Margin="5,0,0,0">
                                                <materialDesign:PackIcon Kind="Search"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <Rectangle Grid.Column="3" Width="0.5" Height="70" Fill="Gray" HorizontalAlignment="Center"/>
                                    
                                    <!-- Filters -->
                                    <Grid Grid.Column="4" Grid.ColumnSpan="3" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                               Text="Filters"
                                               FontFamily="{StaticResource PoppinsMedium}" 
                                               FontSize="15"
                                               Foreground="Black"
                                               HorizontalAlignment="Left"/>

                                        <Grid Grid.Row="1" Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Status Filter -->
                                            <ComboBox x:Name="cbStatusFilter" Grid.Column="0"
                                                  FontFamily="{StaticResource PoppinsRegular}"
                                                  FontSize="13"
                                                  SelectedIndex="0"
                                                  materialDesign:HintAssist.Hint="Status">
                                                <ComboBoxItem Content=""/>
                                                <ComboBoxItem Content="Regular"/>
                                                <ComboBoxItem Content="Independent Contractor"/>
                                            </ComboBox>

                                            <!-- Department Filter -->
                                            <ComboBox x:Name="cbDepartmentFilter" Grid.Column="2"
                                                  FontFamily="{StaticResource PoppinsRegular}"
                                                  FontSize="13"
                                                  SelectedIndex="0"
                                                  materialDesign:HintAssist.Hint="Department">
                                                <ComboBoxItem Content=""/>
                                                <ComboBoxItem Content="HR"/>
                                                <ComboBoxItem Content="IT"/>
                                                <ComboBoxItem Content="Finance"/>
                                            </ComboBox>
                                        </Grid>
                                    </Grid>

                                </Grid>
                            </materialDesign:Card>

                            <!--DATAGRID-->
                            <materialDesign:Card Grid.Row="2" HorizontalAlignment="Stretch" 
                                             VerticalAlignment="Stretch" Background="White" 
                                             UniformCornerRadius="10" BorderBrush="LightGray" 
                                             BorderThickness="1" Effect="{StaticResource CardEffects}"
                                             Padding="20,15" Margin="0,7.5">

                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto">
                                    <DataGrid AutoGenerateColumns="False"
                                          HeadersVisibility="Column"
                                          CanUserAddRows="False"
                                          Margin="0"
                                          ItemsSource="{Binding Employees}"
                                          SelectedItem="{Binding SelectedEmployee}"
                                          materialDesign:DataGridAssist.CellPadding="10"
                                          materialDesign:DataGridAssist.ColumnHeaderPadding="10,5"
                                          RowHeight="40"
                                          FontSize="12"
                                          IsReadOnly="True"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="Transparent">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Employee ID" Binding="{Binding Id}" Width="1*" />
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                                            <DataGridTextColumn Header="Role" Binding="{Binding Position}" Width="1.5*" />
                                            <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="2*" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Name}" Width="1.3*" />
                                            <DataGridTemplateColumn Header="Actions" Width="1.5*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="View" 
                                                            Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" 
                                                            Style="{StaticResource MaterialDesignFlatButton}" 
                                                            Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ScrollViewer>

                            </materialDesign:Card>
                        </Grid>
                    </TabItem>

                    <!--ATTENDANCE LOGS-->
                    <TabItem Header="Attendance Logs">
                        <Grid Margin="20,0,0,0" Background="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="7*"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="5*"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="88*"/>
                            </Grid.RowDefinitions>

                            <!-- TITLE -->
                            <TextBlock Grid.Row="0" Text="ATTENDANCE LOGS" 
                                       FontFamily="{StaticResource PoppinsBold}" 
                                       FontSize="30" Foreground="Black" 
                                       HorizontalAlignment="Left" VerticalAlignment="Top"/>

                            <StackPanel Orientation="Horizontal" Grid.Row="2" VerticalAlignment="Center">
                                <TextBlock Text="Date:    " FontSize="18" FontFamily="{StaticResource PoppinsSemiBold}"/>
                                <DatePicker x:Name="dpDate" 
                                            SelectedDate="{Binding SelectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                            FontFamily="{StaticResource PoppinsRegular}" 
                                            FontSize="15" 
                                            Margin="5,0,0,0" 
                                            Width="200" 
                                            HorizontalAlignment="Left"
                                            DisplayDateEnd="{x:Static sys:DateTime.Today}" />
                            </StackPanel>

                            <!-- DATAGRID -->
                            <materialDesign:Card Grid.Row="4"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Stretch"
                                                 Background="White"
                                                 UniformCornerRadius="10"
                                                 BorderBrush="LightGray"
                                                 BorderThickness="1"
                                                 Effect="{StaticResource CardEffects}"
                                                 Padding="20,15"
                                                 Margin="0,7.5">

                                <DataGrid AutoGenerateColumns="False"
                                          HeadersVisibility="Column"
                                          CanUserAddRows="False"
                                          Margin="0"
                                          ItemsSource="{Binding AttendanceLogs}"
                                          SelectedItem="{Binding SelectedAttendanceLog}"
                                          materialDesign:DataGridAssist.CellPadding="10"
                                          materialDesign:DataGridAssist.ColumnHeaderPadding="10,10"
                                          RowHeight="40"
                                          FontSize="12"
                                          IsReadOnly="True"
                                          Background="Transparent"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Employee ID" Binding="{Binding EmployeeId}" Width="120"/>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
                                        <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="150"/>
                                        <DataGridTextColumn Header="Log Type" Binding="{Binding LogType}" Width="120"/>
                                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="120"/>
                                        <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="200"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                            </materialDesign:Card>

                        </Grid>
                    </TabItem>

                    <!--ATTENDANCE REQUESTS-->
                    <TabItem Header="Attendance Request">
                        <Grid Margin="20,0,0,0" Background="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="7*"/>
                                <RowDefinition Height="93*"/>
                            </Grid.RowDefinitions>

                            <!-- TITLE -->
                            <TextBlock Grid.Row="0" Text="ATTENDANCE REQUEST" 
                                   FontFamily="{StaticResource PoppinsBold}" 
                                   FontSize="30" Foreground="Black" 
                                   HorizontalAlignment="Left" VerticalAlignment="Top"/>

                            <!--DATAGRID-->
                            <materialDesign:Card Grid.Row="1" HorizontalAlignment="Stretch" 
                                                 VerticalAlignment="Stretch" Background="White" 
                                                 UniformCornerRadius="10" BorderBrush="LightGray" 
                                                 BorderThickness="1" Effect="{StaticResource CardEffects}"
                                                 Padding="20,15" Margin="0,7.5">

                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              CanContentScroll="False">
                                    <DataGrid AutoGenerateColumns="False"
                                              HeadersVisibility="Column"
                                              CanUserAddRows="False"
                                              Margin="0"
                                              ItemsSource="{Binding Employees}"
                                              SelectedItem="{Binding SelectedEmployee}"
                                              materialDesign:DataGridAssist.CellPadding="10"
                                              materialDesign:DataGridAssist.ColumnHeaderPadding="10,10"
                                              RowHeight="40"
                                              FontSize="12"
                                              IsReadOnly="True"
                                              Background="Transparent">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Request ID" Binding="{Binding Id}" Width="100" />
                                            <DataGridTextColumn Header="Request Date" Binding="{Binding Name}" Width="150" />
                                            <DataGridTextColumn Header="Employee ID" Binding="{Binding Id}" Width="120" />
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="300" />
                                            <DataGridTextColumn Header="Attendance Date" Binding="{Binding Position}" Width="150" />
                                            <DataGridTextColumn Header="Time In" Binding="{Binding Name}" Width="120" />
                                            <DataGridTextColumn Header="Time Out" Binding="{Binding Name}" Width="120" />
                                            <DataGridTextColumn Header="Break Start" Binding="{Binding Name}" Width="120" />
                                            <DataGridTextColumn Header="Break End" Binding="{Binding Name}" Width="120" />
                                            <DataGridTextColumn Header="Total Hours" Binding="{Binding Position}" Width="120" />
                                            <DataGridTemplateColumn Header="Actions" Width="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="View" 
                                                                Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}" 
                                                                Style="{StaticResource MaterialDesignFlatButton}" 
                                                                Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ScrollViewer>

                            </materialDesign:Card>

                        </Grid>
                    </TabItem>

                    <TabItem Header="Leave">
                        <Grid Margin="20,0,0,0" Background="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="7*"/>
                                <RowDefinition Height="20*"/>
                                <RowDefinition Height="73*"/>
                            </Grid.RowDefinitions>

                            <!-- TITLE -->
                            <TextBlock Grid.Row="0" Text="LEAVE" 
                                       FontFamily="{StaticResource PoppinsBold}" 
                                       FontSize="30" Foreground="Black" 
                                       HorizontalAlignment="Left" VerticalAlignment="Top"/>

                            <!--SUMMARIES-->
                            <materialDesign:Card Grid.Row="1" HorizontalAlignment="Stretch" 
                                                 VerticalAlignment="Stretch" Background="White" 
                                                 UniformCornerRadius="10" BorderBrush="LightGray" 
                                                 BorderThickness="1" Effect="{StaticResource CardEffects}"
                                                 Padding="20,15" Margin="0,7.5">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <!-- Search Bar columnspan of 3 -->
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <!-- Total Employees -->
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <!-- On Leave -->
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <!-- Leave Requests -->
                                    </Grid.ColumnDefinitions>

                                    <!-- SEARCH BAR -->
                                    <Grid Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="Quick Search"
                                                   FontFamily="{StaticResource PoppinsMedium}" 
                                                   FontSize="15"
                                                   Foreground="Black"
                                                   HorizontalAlignment="Left"/>

                                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                                            <TextBox x:Name="tbSearchNameID2"
                                                     materialDesign:HintAssist.Hint="Search Employee Name or ID"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     BorderThickness="0"
                                                     VerticalAlignment="Center" Margin="0,5" Width="300" Height="45"
                                                     Padding="10"
                                                     FontFamily="{StaticResource PoppinsLight}" FontSize="10"/>
                                            <Button x:Name="SearchBtn2" Background="Transparent" Foreground="{StaticResource BaseColorSCB}"
                                                    BorderBrush="Transparent" Style="{StaticResource MaterialDesignIconButton}"
                                                    Height="45" Width="45" Margin="5,0,0,0">
                                                <materialDesign:PackIcon Kind="Search"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Grid.Column="1" Width="0.5" Height="70" Fill="Gray" HorizontalAlignment="Center"/>
                                    <Rectangle Grid.Column="3" Width="0.5" Height="70" Fill="Gray" HorizontalAlignment="Center"/>
                                    <Rectangle Grid.Column="5" Width="0.5" Height="70" Fill="Gray" HorizontalAlignment="Center"/>

                                    <!-- Total Employees -->
                                    <Grid Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="250"
                                                   FontFamily="{StaticResource PoppinsSemiBold}" 
                                                   FontSize="25"
                                                   Foreground="Black"
                                                   HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="1"
                                                   Text="Total Number of Employees"
                                                   FontFamily="{StaticResource PoppinsLight}" 
                                                   FontSize="9"
                                                   Foreground="Black"
                                                   HorizontalAlignment="Left"/>
                                    </Grid>

                                    <!-- On Leave -->
                                    <Grid Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="15"
                                                   FontFamily="{StaticResource PoppinsSemiBold}" 
                                                   FontSize="25"
                                                   Foreground="Black"
                                                   HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="1"
                                                   Text="Employees On Leave"
                                                   FontFamily="{StaticResource PoppinsLight}" 
                                                   FontSize="9"
                                                   Foreground="Black"
                                                   HorizontalAlignment="Left"/>
                                    </Grid>

                                    <!-- Leave Requests -->
                                    <Grid Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="8"
                                                   FontFamily="{StaticResource PoppinsSemiBold}" 
                                                   FontSize="25"
                                                   Foreground="Black"
                                                   HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="1"
                                                   Text="Leave Requests"
                                                   FontFamily="{StaticResource PoppinsLight}" 
                                                   FontSize="9"
                                                   Foreground="Black"
                                                   HorizontalAlignment="Left"/>
                                    </Grid>
                                </Grid>
                            </materialDesign:Card>

                            <!--DATAGRID-->
                            <materialDesign:Card Grid.Row="2" HorizontalAlignment="Stretch" 
                                                 VerticalAlignment="Stretch" Background="White" 
                                                 UniformCornerRadius="10" BorderBrush="LightGray" 
                                                 BorderThickness="1" Effect="{StaticResource CardEffects}"
                                                 Padding="20,15" Margin="0,7.5">

                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                VerticalScrollBarVisibility="Auto">
                                    <DataGrid AutoGenerateColumns="False"
                                              HeadersVisibility="Column"
                                              CanUserAddRows="False"
                                              Margin="0"
                                              ItemsSource="{Binding Employees}"
                                              SelectedItem="{Binding SelectedEmployee}"
                                              materialDesign:DataGridAssist.CellPadding="10"
                                              materialDesign:DataGridAssist.ColumnHeaderPadding="10,5"
                                              RowHeight="40"
                                              FontSize="14"
                                              IsReadOnly="True"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              Background="Transparent">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Emloyee ID" Binding="{Binding Id}" Width="1*" />
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                                            <DataGridTextColumn Header="Leave Type" Binding="{Binding Position}" Width="1.3*" />
                                            <DataGridTextColumn Header="Leave Date" Binding="{Binding Department}" Width="1.3*" />
                                            <DataGridTextColumn Header="Leave Duration" Binding="{Binding Department}" Width="1.3*" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.3*" />
                                            <DataGridTemplateColumn Header="Actions" Width="1*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="View" 
                                                                Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}" 
                                                                Style="{StaticResource MaterialDesignFlatButton}" 
                                                                Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ScrollViewer>

                            </materialDesign:Card>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Leave Requests">
                        <Grid Margin="20,0,0,0" Background="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="7*"/>
                                <RowDefinition Height="93*"/>
                            </Grid.RowDefinitions>

                            <!-- TITLE -->
                            <TextBlock Grid.Row="0" Text="LEAVE REQUESTS" 
                                       FontFamily="{StaticResource PoppinsBold}" 
                                       FontSize="30" Foreground="Black" 
                                       HorizontalAlignment="Left" VerticalAlignment="Top"/>

                            <!--DATAGRID-->
                            <materialDesign:Card Grid.Row="1" HorizontalAlignment="Stretch" 
                                                 VerticalAlignment="Stretch" Background="White" 
                                                 UniformCornerRadius="10" BorderBrush="LightGray" 
                                                 BorderThickness="1" Effect="{StaticResource CardEffects}"
                                                 Padding="20,15" Margin="0,7.5">

                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              CanContentScroll="False">
                                    <DataGrid AutoGenerateColumns="False"
                                              HeadersVisibility="Column"
                                              CanUserAddRows="False"
                                              Margin="0"
                                              ItemsSource="{Binding LeaveRequests}" 
                                              SelectedItem="{Binding SelectedLeaveRequest}"
                                              materialDesign:DataGridAssist.CellPadding="10"
                                              materialDesign:DataGridAssist.ColumnHeaderPadding="10"
                                              RowHeight="40"
                                              FontSize="12"
                                              IsReadOnly="True"
                                              Background="Transparent">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Request ID" Binding="{Binding RequestId}" Width="100" />
                                            <DataGridTextColumn Header="Employee ID" Binding="{Binding EmployeeId}" Width="120" />
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
                                            <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="150" />
                                            <DataGridTextColumn Header="Leave Type" Binding="{Binding LeaveType}" Width="150" />
                                            <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate}" Width="120" />
                                            <DataGridTextColumn Header="End Date" Binding="{Binding EndDate}" Width="120" />
                                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="250" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                                            <DataGridTemplateColumn Header="Actions" Width="100">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="View" 
                                                                Command="{Binding DataContext.ViewLeaveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}" 
                                                                Style="{StaticResource MaterialDesignFlatButton}" 
                                                                Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ScrollViewer>

                            </materialDesign:Card>
                        </Grid>
                    </TabItem>

                </TabControl>

            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
